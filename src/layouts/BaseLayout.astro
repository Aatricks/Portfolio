---
import { ClientRouter } from 'astro:transitions';
import MainHead from '../components/MainHead.astro';
import Footer from '../components/Footer.astro';
import TopBar from '../components/TopBar.astro';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const { title, description } = Astro.props;
---

<html lang="en">
	<head>
		<MainHead title={title} description={description} />
		<ClientRouter />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to main content</a>
		<TopBar />
		<main id="main">
			<slot />
		</main>
		<Footer />

		<script>
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
			const pointerFine = window.matchMedia('(pointer: fine)');
			const wideViewport = window.matchMedia('(min-width: 64em)');
			const revealNodes = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
			const parallaxNodes = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));

			// Assign sequential index to each [data-reveal] within a [data-reveal-stagger] container
			// so CSS can apply a cascading transition-delay via calc(var(--reveal-i) * 70ms).
			document.querySelectorAll<HTMLElement>('[data-reveal-stagger]').forEach((container) => {
				const children = container.querySelectorAll<HTMLElement>('[data-reveal]');
				children.forEach((child, index) => {
					child.style.setProperty('--reveal-i', String(index));
				});
			});

			const markPending = () => {
				const viewportBottom = window.innerHeight;
				revealNodes.forEach((node) => {
					const rect = node.getBoundingClientRect();
					if (rect.top > viewportBottom * 0.95) {
						node.setAttribute('data-reveal-pending', '');
					} else {
						node.classList.add('is-visible');
					}
				});
			};

			if (prefersReducedMotion.matches) {
				revealNodes.forEach((node) => node.classList.add('is-visible'));
			} else if (revealNodes.length > 0) {
				markPending();
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								entry.target.removeAttribute('data-reveal-pending');
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.05, rootMargin: '0px 0px 10% 0px' },
				);
				revealNodes.forEach((node) => observer.observe(node));
			}

			// data-parallax accepts negative speeds (reverse drift for depth); fallback 0.05 only on NaN/0.
			const parallaxState = parallaxNodes.map((node) => ({
				node,
				speed: Number(node.getAttribute('data-parallax')) || 0.05,
				centerY: 0,
			}));

			let viewportHeight = window.innerHeight || 1;
			let ticking = false;

			const parallaxAllowed = () =>
				!prefersReducedMotion.matches && pointerFine.matches && wideViewport.matches;

			const refreshParallax = () => {
				viewportHeight = window.innerHeight || 1;
				const scrollPosition = window.scrollY || 0;
				parallaxState.forEach((entry) => {
					const rect = entry.node.getBoundingClientRect();
					entry.centerY = scrollPosition + rect.top + rect.height / 2;
				});
			};

			const resetParallax = () => {
				parallaxState.forEach((entry) => entry.node.style.setProperty('--parallax-shift', '0px'));
			};

			const applyParallax = () => {
				if (!parallaxAllowed()) {
					resetParallax();
					ticking = false;
					return;
				}
				const scrollPosition = window.scrollY || 0;
				const viewportCenter = scrollPosition + viewportHeight / 2;
				parallaxState.forEach((entry) => {
					const centerOffset = entry.centerY - viewportCenter;
					entry.node.style.setProperty('--parallax-shift', `${(-centerOffset * entry.speed).toFixed(2)}px`);
				});
				ticking = false;
			};

			const onScroll = () => {
				if (!ticking) {
					window.requestAnimationFrame(applyParallax);
					ticking = true;
				}
				window.dispatchEvent(
					new CustomEvent('site:scroll', {
						detail: { scroll: window.scrollY || 0 },
					}),
				);
			};

			const onResize = () => {
				refreshParallax();
				applyParallax();
			};

			refreshParallax();
			applyParallax();
			window.addEventListener('scroll', onScroll, { passive: true });
			window.addEventListener('resize', onResize);
			window.addEventListener('load', () => {
				refreshParallax();
				applyParallax();
			});
			const onMediaChange = () => {
				refreshParallax();
				applyParallax();
			};
			pointerFine.addEventListener('change', onMediaChange);
			wideViewport.addEventListener('change', onMediaChange);

			const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
			if (themeToggle) {
				const update = () => {
					const current = document.documentElement.dataset.theme || 'light';
					themeToggle.setAttribute('aria-pressed', current === 'dark' ? 'true' : 'false');
					themeToggle.dataset.current = current;
				};
				update();
				themeToggle.addEventListener('click', () => {
					const next = (document.documentElement.dataset.theme || 'light') === 'dark' ? 'light' : 'dark';
					document.documentElement.dataset.theme = next;
					try {
						localStorage.setItem('theme', next);
					} catch (_) {
						/* ignore */
					}
					update();
				});
			}
		</script>

		<style>
			.skip-link {
				position: absolute;
				top: -100px;
				left: 1rem;
				padding: 0.6rem 1rem;
				background: var(--ink);
				color: var(--paper);
				z-index: 100;
				font-family: var(--font-mono);
				font-size: 0.78rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				transition: top 200ms var(--ease);
			}
			.skip-link:focus {
				top: 1rem;
			}
			main {
				display: block;
				min-height: 60vh;
			}
		</style>
	</body>
</html>
