---
interface StackEntry {
	name: string;
	note?: string;
}

interface StackGroup {
	label: string;
	caption?: string;
	entries: StackEntry[];
}

const groups: StackGroup[] = [
	{
		label: 'languages & systems',
		caption: 'where the time goes',
		entries: [
			{ name: 'C / C++', note: 'llmedge JNI bridges · CChess · submarine control' },
			{ name: 'Objective-C / Metal', note: 'FrameLimiter — CAMetalLayer swizzle, mach_wait_until pacing' },
			{ name: 'Rust', note: 'Pilotrs flight-control core — no_std, MEKF/LQR, Ferrocene-ready' },
			{ name: 'Kotlin', note: 'llmedge API · EasyReader — Compose, Hilt, Room' },
			{ name: 'Python', note: 'LightDiffusion pipelines · PyTorch tooling' },
			{ name: 'Linux', note: 'daily driver — Arch + NixOS flakes, kernel debugging' },
		],
	},
	{
		label: 'ai & inference',
		caption: 'model-side discipline',
		entries: [
			{ name: 'PyTorch', note: 'diffusion optimization · scheduler work' },
			{ name: 'llama.cpp', note: 'GGUF on-device LLM in llmedge' },
			{ name: 'stable-diffusion.cpp', note: 'mobile + desktop diffusion pipelines' },
			{ name: 'Vulkan / OpenCL', note: 'backend fallback policy · compute shaders' },
		],
	},
	{
		label: 'embedded & signal',
		caption: 'what brought me here',
		entries: [
			{ name: 'Sensor fusion', note: 'IMU + Kalman on the autonomous submarine' },
			{ name: 'Arduino / ARM', note: 'prototyping, peripherals' },
			{ name: 'Computer vision', note: 'training + classical pipelines' },
			{ name: '3D modelling / print', note: 'functional parts for embedded projects' },
		],
	},
];

const languages = [
	{ code: 'fr', name: 'Français', level: 'C2 · native' },
	{ code: 'en', name: 'English', level: 'C1 · fluent' },
	{ code: 'es', name: 'Español', level: 'B2' },
	{ code: 'it', name: 'Italiano', level: 'B2' },
	{ code: 'ru', name: 'Русский', level: 'B1' },
];
---

<div class="stack-grid" data-reveal-stagger>
	{groups.map((group) => (
		<section class="stack-group" data-reveal>
			<header class="stack-group__head">
				<p class="stack-group__label">{group.label}</p>
				{group.caption && <p class="stack-group__caption">{group.caption}</p>}
			</header>
			<ul class="stack-group__list" data-reveal-stagger>
				{group.entries.map((entry) => (
					<li class="stack-row" data-reveal>
						<span class="stack-row__name">{entry.name}</span>
						{entry.note && <span class="stack-row__note">— {entry.note}</span>}
					</li>
				))}
			</ul>
		</section>
	))}
</div>

<aside class="stack-langs" data-reveal aria-labelledby="langs-title">
	<p class="stack-langs__label" id="langs-title">— spoken</p>
	<ul class="stack-langs__list">
		{languages.map((lang) => (
			<li class="stack-langs__item">
				<span class="stack-langs__code">{lang.code}</span>
				<span class="stack-langs__name">{lang.name}</span>
				<span class="stack-langs__level">{lang.level}</span>
			</li>
		))}
	</ul>
</aside>

<style>
	.stack-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	.stack-group__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.7rem;
		margin-bottom: 0.5rem;
		border-bottom: 1px solid var(--rule);
	}

	.stack-group__label {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.stack-group__caption {
		font-family: var(--font-display);
		font-style: italic;
		font-size: 0.95rem;
		color: var(--mute);
	}

	.stack-group__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0;
	}

	.stack-row {
		padding: 0.5rem 0;
		line-height: 1.5;
		border-bottom: 1px dashed var(--rule-soft);
	}

	.stack-row:last-child {
		border-bottom: 0;
	}

	.stack-row__name {
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 400;
		color: var(--ink);
		letter-spacing: -0.01em;
		margin-right: 0.55rem;
	}

	.stack-row__note {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: var(--mute);
	}

	.stack-langs {
		margin-top: 2.5rem;
		padding: 1.4rem 0 0;
		border-top: 1px dashed var(--rule);
	}

	.stack-langs__label {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--mute);
		margin-bottom: 0.85rem;
	}

	.stack-langs__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
		gap: 0.7rem 1.6rem;
	}

	.stack-langs__item {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: baseline;
		gap: 0.5rem;
	}

	.stack-langs__code {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.8rem;
		padding: 0.05rem 0.35rem;
		border: 1px solid var(--rule);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent);
	}

	.stack-langs__name {
		font-family: var(--font-display);
		font-size: 1rem;
		color: var(--ink);
	}

	.stack-langs__level {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--mute);
	}

	@media (min-width: 52em) {
		.stack-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 2.5rem;
		}
	}
</style>
