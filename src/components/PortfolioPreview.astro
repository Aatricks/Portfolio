---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
	variant?: 'dominant' | 'secondary' | 'coflagship';
	stars?: number | undefined;
}

const { project, variant = 'secondary', stars } = Astro.props;
const { data, id } = project;
const href = `/Portfolio/work/${id.replace(/\.md$/, '')}`;
const proofParts = [
	...(stars && stars > 0 ? [`★ ${stars}`] : []),
	...(data.proof ? [data.proof] : []),
];
// SVG diagrams ship a `-dark.svg` companion (see scripts/gen-dark-diagrams.mjs) so
// they don't render as a bright card on a dark page. CSS swaps which one is shown.
const imgDark = data.img.endsWith('.svg') ? data.img.replace(/\.svg$/, '-dark.svg') : null;
---

<article
	class={`pp pp--${variant} pp--${data.themeKey}`}
	style={`--pp-a: ${data.accent}; --pp-a-dark: ${data.accentDark};`}
	data-reveal
>
	<a class="pp__link" href={href}>
		<div class="pp__head">
			<span class="pp__eyebrow">{data.eyebrow}</span>
			<h3 class="pp__title">
				<span transition:name={`title-${data.themeKey}`}>{data.title}</span>
				<span class="pp__arrow" aria-hidden="true">↗</span>
			</h3>
			{data.blurb && <p class="pp__blurb">{data.blurb}</p>}
		</div>

		<div class="pp__media">
			<div class="pp__media-frame">
				<div class="pp__chrome" aria-hidden="true">
					<span class="pp__chrome-dots"><i></i><i></i><i></i></span>
					<span class="pp__chrome-path">{data.hint ?? href}</span>
				</div>
				<div class="pp__media-view">
					<div class="pp__media-inner" data-parallax="0.025">
						{imgDark ? (
							<>
								<img class="theme-img--light" src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" />
								<img class="theme-img--dark" src={imgDark} alt={data.img_alt || ''} loading="lazy" decoding="async" />
							</>
						) : (
							<img src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" />
						)}
					</div>
				</div>
			</div>
		</div>

		<div class="pp__foot">
			<span class="pp__stack">{data.stackLine}</span>
			{proofParts.length > 0 && (
				<span class="pp__proof">{proofParts.join(' · ')}</span>
			)}
		</div>
	</a>
</article>

<style>
	.pp {
		--pp-accent: var(--pp-a, var(--accent));
		border-bottom: 1px solid var(--rule);
	}

	:global([data-theme='dark']) .pp {
		--pp-accent: var(--pp-a-dark, var(--accent));
	}

	.pp__link {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.6rem;
		padding-block: 2.4rem;
		color: var(--ink);
		position: relative;
	}

	.pp__link::before {
		content: '';
		position: absolute;
		left: -1.4rem;
		top: 2.4rem;
		bottom: 2.4rem;
		width: 2px;
		background: var(--pp-accent);
		opacity: 0;
		transform: translateX(0.4rem);
		transition: opacity var(--t-link) var(--ease), transform var(--t-link) var(--ease);
	}

	.pp__link:hover::before {
		opacity: 1;
		transform: translateX(0);
	}

	.pp__eyebrow {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--pp-accent);
		margin-bottom: 0.85rem;
	}

	.pp__title {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		font-family: var(--font-display);
		font-weight: 400;
		font-variation-settings: 'opsz' 144, 'SOFT' 30, 'WONK' 0;
		font-size: clamp(2rem, 4.2vw, 3.4rem);
		line-height: 1.04;
		letter-spacing: -0.022em;
		color: var(--ink);
		margin-bottom: 1rem;
		transition: font-variation-settings 360ms var(--ease);
	}

	.pp__link:hover .pp__title {
		font-variation-settings: 'opsz' 144, 'SOFT' 90, 'WONK' 1;
	}

	.pp__blurb {
		max-width: 34rem;
		font-size: 0.98rem;
		line-height: 1.6;
		color: var(--ink-soft);
	}

	.pp__arrow {
		font-family: var(--font-mono);
		font-size: 0.85em;
		color: var(--mute);
		transition: color var(--t-link) var(--ease), transform var(--t-link) var(--ease);
	}

	.pp__link:hover .pp__arrow {
		color: var(--pp-accent);
		transform: translate(4px, -4px);
	}

	.pp__media {
		position: relative;
		order: -1;
	}

	.pp__media-frame {
		border: 1px solid var(--rule);
		background: var(--paper-soft);
		transition: border-color var(--t-link) var(--ease);
	}

	.pp__link:hover .pp__media-frame {
		border-color: color-mix(in srgb, var(--pp-accent) 45%, var(--rule));
	}

	.pp__chrome {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.45rem 0.7rem;
		border-bottom: 1px solid var(--rule);
		background: var(--paper-deep);
	}

	.pp__chrome-dots {
		display: inline-flex;
		gap: 0.3rem;
	}

	.pp__chrome-dots i {
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 999px;
		border: 1px solid var(--mute-soft);
		background: transparent;
		transition: background-color var(--t-link) var(--ease), border-color var(--t-link) var(--ease);
	}

	.pp__link:hover .pp__chrome-dots i:first-child {
		background: var(--pp-accent);
		border-color: var(--pp-accent);
	}

	.pp__chrome-path {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.03em;
		color: var(--mute);
		text-transform: lowercase;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.pp__media-view {
		overflow: hidden;
		aspect-ratio: 16 / 10;
		position: relative;
	}

	.pp__media-view::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			135deg,
			color-mix(in srgb, var(--pp-accent) 10%, transparent),
			transparent 60%
		);
		pointer-events: none;
		opacity: 0.5;
		transition: opacity var(--t-link) var(--ease);
	}

	.pp__link:hover .pp__media-view::after {
		opacity: 1;
	}

	.pp__media-inner {
		position: absolute;
		inset: -6% 0;
		width: 100%;
		will-change: transform;
	}

	.pp__media-view img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 800ms var(--ease);
	}

	.pp__link:hover .pp__media-view img {
		transform: scale(1.025);
	}

	.pp__foot {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.5rem 2rem;
	}

	.pp__stack {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--ink-soft);
		line-height: 1.5;
	}

	.pp__proof {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.03em;
		color: var(--pp-accent);
		line-height: 1.5;
	}

	/* Dominant variant: side-by-side */
	@media (min-width: 64em) {
		.pp--dominant .pp__link {
			grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
			gap: 3rem;
			align-items: start;
		}
		.pp--dominant .pp__media {
			order: 0;
		}
		.pp--dominant .pp__head {
			padding-top: 0.6rem;
		}
		.pp--dominant .pp__foot {
			grid-column: 1 / -1;
		}
	}

	/* Secondary variant: alternates rows */
	@media (min-width: 64em) {
		.pp--secondary .pp__link {
			grid-template-columns: minmax(0, 0.55fr) minmax(0, 0.45fr);
			column-gap: 3rem;
			align-items: start;
		}
		.pp--secondary .pp__media {
			order: 0;
		}
		.pp--secondary .pp__foot {
			grid-column: 1 / -1;
		}
	}
</style>
