---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
	variant?: 'dominant' | 'secondary';
}

const { project, variant = 'secondary' } = Astro.props;
const { data, id } = project;
const href = `/Portfolio/work/${id.replace(/\.md$/, '')}`;
const leadMetric = data.metrics[0];
const altMetric = data.metrics[1];
---

<article class={`pp pp--${variant} pp--${data.themeKey}`} data-reveal>
	<a class="pp__link" href={href}>
		<div class="pp__head">
			<div class="pp__meta">
				<span class="pp__eyebrow">{data.eyebrow}</span>
				<span class="pp__sep" aria-hidden="true">·</span>
				<span class="pp__id">/{data.themeKey}</span>
			</div>

			<h3 class="pp__title">
				<span>{data.title}</span>
				<span class="pp__arrow" aria-hidden="true">↗</span>
			</h3>

			<p class="pp__thesis">{data.thesis}</p>
		</div>

		<div class="pp__media">
			<div class="pp__media-frame">
				<div class="pp__media-inner" data-parallax="0.025">
					<img src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" />
				</div>
			</div>
			<div class="pp__media-tag" aria-hidden="true">
				<span class="dot dot--ok"></span>
				<span>live</span>
			</div>
		</div>

		<div class="pp__foot">
			<dl class="pp__metrics">
				{leadMetric && (
					<div class="pp__metric">
						<dt>{leadMetric.label}</dt>
						<dd>{leadMetric.value}</dd>
					</div>
				)}
				{altMetric && variant === 'dominant' && (
					<div class="pp__metric">
						<dt>{altMetric.label}</dt>
						<dd>{altMetric.value}</dd>
					</div>
				)}
				<div class="pp__metric pp__metric--stack">
					<dt>stack</dt>
					<dd>{data.stackLine}</dd>
				</div>
			</dl>
		</div>
	</a>
</article>

<style>
	.pp {
		--pp-accent: var(--accent);
		border-bottom: 1px solid var(--rule);
	}

	.pp--llmedge {
		--pp-accent: #2b6cb0;
	}
	.pp--lightdiffusion-next {
		--pp-accent: #b8421a;
	}
	.pp--easyreader {
		--pp-accent: #2f7a3a;
	}
	.pp--cchess {
		--pp-accent: #6b2b8a;
	}

	[data-theme='dark'] .pp--llmedge {
		--pp-accent: #79a7ff;
	}
	[data-theme='dark'] .pp--lightdiffusion-next {
		--pp-accent: #f4b458;
	}
	[data-theme='dark'] .pp--easyreader {
		--pp-accent: #7ad88a;
	}
	[data-theme='dark'] .pp--cchess {
		--pp-accent: #b288d4;
	}

	.pp__link {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.6rem;
		padding-block: 2.4rem;
		color: var(--ink);
		position: relative;
	}

	.pp__link::before {
		content: '';
		position: absolute;
		left: -1.4rem;
		top: 2.4rem;
		bottom: 2.4rem;
		width: 2px;
		background: var(--pp-accent);
		opacity: 0;
		transform: translateX(0.4rem);
		transition: opacity 320ms var(--ease), transform 320ms var(--ease);
	}

	.pp__link:hover::before {
		opacity: 1;
		transform: translateX(0);
	}

	.pp__meta {
		display: inline-flex;
		gap: 0.5rem;
		align-items: baseline;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--mute);
		margin-bottom: 0.85rem;
	}

	.pp__eyebrow {
		color: var(--pp-accent);
		letter-spacing: 0.14em;
	}

	.pp__sep {
		color: var(--mute-soft);
	}

	.pp__id {
		color: var(--mute);
	}

	.pp__title {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(2rem, 4.2vw, 3.4rem);
		line-height: 1.04;
		letter-spacing: -0.022em;
		color: var(--ink);
		margin-bottom: 1rem;
	}

	.pp__arrow {
		font-family: var(--font-mono);
		font-size: 0.85em;
		color: var(--mute);
		transition: color 220ms var(--ease), transform 320ms var(--ease);
	}

	.pp__link:hover .pp__arrow {
		color: var(--pp-accent);
		transform: translate(4px, -4px);
	}

	.pp__thesis {
		max-width: 38rem;
		font-size: 1.04rem;
		line-height: 1.65;
		color: var(--ink-soft);
	}

	.pp__media {
		position: relative;
		order: -1;
	}

	.pp__media-frame {
		overflow: hidden;
		border: 1px solid var(--rule);
		background: var(--paper-soft);
		aspect-ratio: 16 / 10;
		position: relative;
	}

	.pp__media-frame::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			135deg,
			color-mix(in srgb, var(--pp-accent) 10%, transparent),
			transparent 60%
		);
		pointer-events: none;
		opacity: 0.5;
		transition: opacity 320ms var(--ease);
	}

	.pp__link:hover .pp__media-frame::after {
		opacity: 1;
	}

	.pp__media-inner {
		position: absolute;
		inset: -6% 0;
		width: 100%;
		will-change: transform;
	}

	.pp__media-frame img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 800ms var(--ease);
	}

	.pp__link:hover .pp__media-frame img {
		transform: scale(1.025);
	}

	.pp__media-tag {
		position: absolute;
		bottom: 0.8rem;
		left: 0.8rem;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.55rem;
		background: var(--paper);
		border: 1px solid var(--rule);
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.pp__foot {
		display: grid;
		gap: 0.8rem;
	}

	.pp__metrics {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.8rem 1.5rem;
		margin: 0;
		padding-top: 0.85rem;
		border-top: 1px dashed var(--rule);
	}

	.pp__metric {
		display: grid;
		grid-template-columns: 7rem 1fr;
		align-items: baseline;
		gap: 0.7rem;
	}

	.pp__metric dt {
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--mute);
	}

	.pp__metric dd {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--ink);
		line-height: 1.45;
	}

	.pp__metric--stack dd {
		color: var(--ink-soft);
	}

	/* Dominant variant — side-by-side */
	@media (min-width: 64em) {
		.pp--dominant .pp__link {
			grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
			gap: 3rem;
			align-items: start;
		}
		.pp--dominant .pp__media {
			order: 0;
		}
		.pp--dominant .pp__head {
			padding-top: 0.6rem;
		}
		.pp--dominant .pp__foot {
			grid-column: 1 / -1;
		}
	}

	/* Secondary variant — alternates rows */
	@media (min-width: 64em) {
		.pp--secondary .pp__link {
			grid-template-columns: minmax(0, 0.55fr) minmax(0, 0.45fr);
			column-gap: 3rem;
			align-items: start;
		}
		.pp--secondary .pp__media {
			order: 0;
		}
		.pp--secondary .pp__foot {
			grid-column: 1 / -1;
		}
		.pp--secondary:nth-of-type(even) .pp__media {
			order: 2;
		}
	}
</style>
