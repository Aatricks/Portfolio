---
interface Props {
	title: string;
	title2?: string;
	tagline?: string;
	align?: 'start' | 'center';
	variant?: 'display' | 'page';
}

const { align = 'center', tagline, title, title2, variant = 'display' } = Astro.props;
---

<header class:list={['hero-block', `hero-block--${align}`, `hero-block--${variant}`]}>
	<p class="hero-block__mark">§ 00 · status</p>
	<h1 class="hero-block__title">
		<span>{title}</span>
		{title2 && <span class="hero-block__title--muted">{title2}</span>}
	</h1>
	{tagline && <p class="hero-block__tag">{tagline}</p>}
	<slot />
</header>

<style>
	.hero-block {
		display: grid;
		gap: 1.5rem;
		padding-block: 6rem 5rem;
		text-align: center;
		justify-items: center;
	}

	.hero-block--start {
		text-align: left;
		justify-items: start;
	}

	.hero-block__mark {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--mute);
	}

	.hero-block__title {
		font-family: var(--font-display);
		font-size: clamp(2.6rem, 7vw, 5rem);
		font-weight: 400;
		line-height: 0.98;
		letter-spacing: -0.025em;
		max-width: 14ch;
		color: var(--ink);
	}

	.hero-block__title--muted {
		display: block;
		color: var(--mute);
		font-style: italic;
		font-size: 0.72em;
	}

	.hero-block__tag {
		max-width: 40rem;
		font-size: 1.05rem;
		line-height: 1.65;
		color: var(--ink-soft);
	}
</style>
