---
import type { CollectionEntry } from 'astro:content';
import CaseStudyLayout from './CaseStudyLayout.astro';

const { entry, Content } = Astro.props as {
	entry: CollectionEntry<'work'>;
	Content: any;
};
---

<CaseStudyLayout
	entry={entry}
	Content={Content}
	themeKey="lightdiffusion-next"
	accent="#b8421a"
	accentDark="#f4b458"
	hint="~/LightDiffusion-Next/pipeline.py"
	galleryColumns="double"
/>
