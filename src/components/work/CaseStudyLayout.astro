---
import type { CollectionEntry } from 'astro:content';
import ProjectActions from './ProjectActions.astro';
import ProjectGallery from './ProjectGallery.astro';

interface Props {
	entry: CollectionEntry<'work'>;
	Content: any;
	accent: string;
	accentDark?: string;
	themeKey: string;
	hint?: string;
	backHref?: string;
	galleryColumns?: 'single' | 'double';
}

const {
	entry,
	Content,
	accent,
	accentDark,
	themeKey,
	hint = '',
	backHref = '/Portfolio/',
	galleryColumns = 'double',
} = Astro.props;
const { data } = entry;
const publishYear = data.publishDate.getFullYear();
const publishMonth = String(data.publishDate.getMonth() + 1).padStart(2, '0');
const stackComponents = data.stackLine.split('/').map((s: string) => s.trim()).filter(Boolean).length;
const publishIso = data.publishDate.toISOString().slice(0, 10);
const buildLabel = [
	`build ${publishYear}.${publishMonth}`,
	`stack · ${stackComponents} components`,
	`published ${publishIso}`,
];
---

<article
	class={`project-page project-page--${themeKey}`}
	data-project-theme={themeKey}
	style={`--proj: ${accent}; --proj-dark: ${accentDark ?? accent};`}
>
	<header class="project-page__hero">
		<div class="project-page__hero-bg" aria-hidden="true" data-parallax="0.05"></div>
		<div class="wrapper wrapper--narrow project-page__hero-inner">
			<nav class="project-page__nav">
				<a class="project-page__back" href={backHref}>
					<span aria-hidden="true">←</span>
					<span>back</span>
				</a>
			</nav>

			<div class="project-page__hero-grid">
				<div class="project-page__hero-copy">
					<ul class="project-page__ribbon" aria-label="Build metadata">
						{buildLabel.map((part, i) => (
							<li>
								<span>{part}</span>
								{i < buildLabel.length - 1 && <span class="project-page__ribbon-sep" aria-hidden="true">·</span>}
							</li>
						))}
					</ul>
					<h1 class="project-page__title"><span transition:name={`title-${themeKey}`}>{data.title}</span></h1>
					<p class="project-page__thesis">{data.thesis}</p>

					<div class="project-page__tech-stack">
						<span class="project-page__tech-label">stack //</span>
						<span class="project-page__tech-value">{data.stackLine}</span>
					</div>

					<div class="project-page__actions">
						<ProjectActions
							repoUrl={data.repoUrl}
							docsUrl={data.docsUrl}
							demoUrl={data.demoUrl}
						/>
					</div>
				</div>
			</div>
		</div>
	</header>

	<div class="wrapper wrapper--narrow project-page__body">
		{data.architecture && data.architecture.length > 0 && (
			<section class="project-page__arch" data-reveal>
				<p class="section-marker">architecture flow</p>
				<div class="arch-diagram" data-reveal-stagger>
					{data.architecture.map((step, i) => (
						<div class="arch-step" data-reveal>
							<span class="arch-step__number">{String(i + 1).padStart(2, '0')}</span>
							<p class="arch-step__desc">{step}</p>
							{i < data.architecture.length - 1 && (
								<div class="arch-step__connector" aria-hidden="true">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<line x1="5" y1="12" x2="19" y2="12"></line>
										<polyline points="12 5 19 12 12 19"></polyline>
									</svg>
								</div>
							)}
						</div>
					))}
				</div>
			</section>
		)}

		{data.gallery.length > 0 && (
			<section class="project-page__gallery" data-reveal>
				<p class="section-marker">visuals</p>
				<ProjectGallery items={data.gallery} columns={galleryColumns} />
			</section>
		)}

		<section class="project-page__notes" data-reveal>
			<p class="section-marker">engineering notes</p>
			<div class="project-prose">
				<Content />
			</div>
		</section>
	</div>
</article>

<style>
	.project-page {
		--project-accent: var(--proj);
		padding-bottom: 5rem;
	}

	[data-theme='dark'] .project-page {
		--project-accent: var(--proj-dark, var(--proj));
	}

	/* ---------------- HERO ---------------- */
	.project-page__hero {
		padding-block: clamp(3rem, 8vw, 6rem) clamp(3rem, 7vw, 5rem);
		border-bottom: 1px solid var(--rule-soft);
		position: relative;
		overflow: clip;
	}

	.project-page__hero-bg {
		position: absolute;
		inset: -10vh -10vw auto auto;
		width: 60vw;
		height: 60vw;
		max-width: 720px;
		max-height: 720px;
		background: radial-gradient(
			closest-side,
			color-mix(in srgb, var(--project-accent) 10%, transparent),
			transparent 70%
		);
		pointer-events: none;
		filter: blur(48px);
		opacity: 0.55;
		will-change: transform;
	}

	[data-theme='dark'] .project-page__hero-bg {
		opacity: 0.4;
	}

	.project-page__hero-inner {
		position: relative;
	}

	.project-page__nav {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 2.5rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		color: var(--mute);
	}

	.project-page__back {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--ink-soft);
		text-transform: lowercase;
	}

	.project-page__back:hover {
		color: var(--project-accent);
	}

	.project-page__breadcrumb {
		color: var(--mute-soft);
		font-size: 0.68rem;
		text-transform: lowercase;
	}

	.project-page__hero-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
	}

	.project-page__marker {
		margin-bottom: 1rem;
	}

	.project-page__ribbon {
		list-style: none;
		padding: 0;
		margin: 0 0 1.1rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		text-transform: lowercase;
		color: var(--mute);
		border-top: 1px solid var(--rule-soft);
		border-bottom: 1px solid var(--rule-soft);
		padding-block: 0.55rem;
	}

	.project-page__ribbon li {
		display: inline-flex;
		gap: 0.4rem;
		align-items: baseline;
	}

	.project-page__ribbon li span:first-child {
		color: var(--ink-soft);
	}

	.project-page__ribbon-sep {
		color: var(--mute-soft);
		margin-left: 0.4rem;
	}

	.project-page__eyebrow {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--project-accent);
		margin-bottom: 0.85rem;
	}

	.project-page__title {
		font-family: var(--font-display);
		font-size: clamp(2.8rem, 8.5vw, 6.4rem);
		font-weight: 400;
		font-variation-settings: 'opsz' 144, 'SOFT' 30, 'WONK' 1;
		line-height: 0.94;
		letter-spacing: -0.03em;
		color: var(--ink);
		margin-bottom: 1.4rem;
		transition: font-variation-settings 380ms var(--ease);
	}

	.project-page__title:hover,
	.project-page__title:focus-within {
		font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1;
	}

	/* Optical bleed removed for clean alignment */

	.project-page__thesis {
		max-width: 42rem;
		margin-inline: auto;
		font-size: clamp(1.08rem, 1.8vw, 1.32rem);
		line-height: 1.55;
		color: var(--ink-soft);
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 400;
		margin-bottom: 2rem;
	}

	.project-page__hero-copy {
		max-width: 56rem;
		margin-inline: auto;
		text-align: center;
	}

	.project-page__tech-stack {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		margin-bottom: 2rem;
	}

	.project-page__tech-label {
		color: var(--project-accent);
		text-transform: lowercase;
		letter-spacing: 0.08em;
	}

	.project-page__tech-value {
		color: var(--ink-soft);
	}

	.project-page__actions {
		display: flex;
		justify-content: center;
	}

	/* ---------------- BODY ---------------- */
	.project-page__body {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 4.5rem;
		padding-top: 3.5rem;
	}

	.project-page__arch {
		padding: 1.6rem 1.4rem;
		background: var(--paper-soft);
		border: 1px solid var(--rule);
		position: relative;
	}

	.project-page__arch::before {
		content: '';
		position: absolute;
		top: -1px;
		left: 1.2rem;
		width: 2rem;
		height: 2px;
		background: var(--project-accent);
	}

	.arch-diagram {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
		margin-top: 1.5rem;
		position: relative;
	}

	.arch-step {
		background: var(--paper-soft);
		border: 1px solid var(--rule);
		border-radius: 6px;
		padding: 1.25rem 1.1rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		position: relative;
		transition: background-color 0.25s, border-color 0.25s, transform 0.25s;
	}

	.arch-step:hover {
		background: var(--paper-deep);
		border-color: var(--project-accent);
		transform: translateY(-2px);
	}

	.arch-step__number {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--project-accent);
		letter-spacing: 0.1em;
		font-weight: 500;
	}

	.arch-step__desc {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.5;
		color: var(--ink-soft);
	}

	.arch-step__connector {
		position: absolute;
		top: 50%;
		right: -1.25rem;
		transform: translateY(-50%);
		width: 1rem;
		height: 1rem;
		color: var(--mute-soft);
		z-index: 10;
		pointer-events: none;
		transition: color 0.25s;
	}

	.arch-step__connector svg {
		width: 100%;
		height: 100%;
		transition: transform 0.25s;
	}

	.arch-step:hover .arch-step__connector {
		color: var(--project-accent);
	}

	.arch-step:hover .arch-step__connector svg {
		transform: translateX(3px);
	}

	@media (max-width: 64em) {
		.arch-diagram {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.arch-step__connector {
			top: auto;
			bottom: -1.5rem;
			right: auto;
			left: 50%;
			transform: translateX(-50%);
		}

		.arch-step__connector svg {
			transform: rotate(90deg);
		}

		.arch-step:hover .arch-step__connector svg {
			transform: rotate(90deg) translateY(3px);
		}
	}

	/* gallery / notes */
	.project-page__gallery,
	.project-page__notes {
		display: grid;
		gap: 1.5rem;
	}

	.project-page__notes {
		max-width: 56rem;
		padding-top: 2.5rem;
		border-top: 1px solid var(--rule);
	}

	.project-prose {
		font-size: 1.02rem;
		line-height: 1.75;
		color: var(--ink-soft);
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1rem;
		overflow-wrap: break-word;
	}

	.project-prose :global(h2) {
		font-family: var(--font-display);
		font-size: 1.6rem;
		font-weight: 400;
		font-style: italic;
		font-variation-settings: 'opsz' 144, 'SOFT' 70, 'WONK' 1;
		color: var(--ink);
		margin-top: 2rem;
		margin-bottom: 0.4rem;
		letter-spacing: -0.012em;
	}

	.project-prose :global(h3) {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 400;
		color: var(--ink);
		margin-top: 1.5rem;
	}

	.project-prose :global(p),
	.project-prose :global(ul) {
		margin: 0;
	}

	.project-prose :global(ul) {
		padding-left: 1.2rem;
	}

	.project-prose :global(strong) {
		color: var(--ink);
		font-weight: 500;
	}

	.project-prose :global(code) {
		font-family: var(--font-mono);
		font-size: 0.88em;
		padding: 0.08rem 0.32rem;
		background: var(--paper-deep);
		border: 1px solid var(--rule);
		color: var(--ink);
	}

	/* single column grid layout cleanup */
</style>
