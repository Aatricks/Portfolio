---
import type { CollectionEntry } from 'astro:content';
import CaseStudyLayout from './CaseStudyLayout.astro';

const { entry, Content } = Astro.props as {
	entry: CollectionEntry<'work'>;
	Content: any;
};
---

<CaseStudyLayout
	entry={entry}
	Content={Content}
	themeKey="llmedge"
	accent="#2b6cb0"
	accentDark="#79a7ff"
	hint="~/llmedge/runtime.kt"
	galleryColumns="single"
/>
