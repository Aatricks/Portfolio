---
interface GalleryItem {
	src: string;
	alt: string;
	caption?: string;
}

interface Props {
	items: GalleryItem[];
	columns?: 'single' | 'double';
}

const { items, columns = 'double' } = Astro.props;
---

{items.length > 0 && (
	<section class={`gallery gallery--${columns}`}>
		{items.map((item, i) => (
			<figure class="gallery__item" data-reveal>
				<div class="gallery__frame">
					<span class="gallery__id" aria-hidden="true">fig {String(i + 1).padStart(2, '0')}</span>
					<img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
				</div>
				{item.caption && <figcaption class="gallery__caption">{item.caption}</figcaption>}
			</figure>
		))}
	</section>
)}

<style>
	.gallery {
		display: grid;
		gap: 2rem;
	}

	.gallery--double {
		grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
	}

	.gallery__item {
		display: grid;
		gap: 0.85rem;
		margin: 0;
	}

	.gallery__frame {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--rule);
		background: var(--paper-soft);
	}

	.gallery__id {
		position: absolute;
		top: 0.5rem;
		left: 0.6rem;
		padding: 0.18rem 0.45rem;
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-soft);
		background: var(--paper);
		border: 1px solid var(--rule);
		z-index: 1;
	}

	.gallery__frame img {
		width: 100%;
		height: auto;
		display: block;
	}

	.gallery__caption {
		font-family: var(--font-display);
		font-style: italic;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--mute);
		max-width: 44rem;
		padding-left: 0.85rem;
		border-left: 1px solid var(--rule);
	}
</style>
