---
import type { CollectionEntry } from 'astro:content';
import CaseStudyLayout from './CaseStudyLayout.astro';

const { entry, Content } = Astro.props as {
	entry: CollectionEntry<'work'>;
	Content: any;
};
---

<CaseStudyLayout
	entry={entry}
	Content={Content}
	themeKey="cchess"
	accent="#6b2b8a"
	accentDark="#b288d4"
	hint="~/CChess/board.c"
	backHref="/Portfolio/#more"
	galleryColumns="single"
/>
