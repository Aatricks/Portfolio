---
interface Metric {
	label: string;
	value: string;
}

interface Props {
	metrics: Metric[];
}

const { metrics } = Astro.props;
---

{metrics.length > 0 && (
	<section class="project-page__metrics" aria-label="Project metrics">
		<dl class="metrics">
			{metrics.map((metric, i) => (
				<div class="metrics__row">
					<dt>
						<span class="metrics__index">{String(i + 1).padStart(2, '0')}</span>
						<span class="metrics__label">{metric.label}</span>
					</dt>
					<dd>{metric.value}</dd>
				</div>
			))}
		</dl>
	</section>
)}

<style>
	.project-page__metrics {
		padding-block: 2rem;
		border-block: 1px solid var(--rule);
	}

	.metrics {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0;
		margin: 0;
	}

	.metrics__row {
		display: grid;
		grid-template-columns: minmax(12rem, 1fr) minmax(0, 2fr);
		gap: 1.4rem;
		padding-block: 0.9rem;
		border-bottom: 1px dashed var(--rule-soft);
	}

	.metrics__row:last-child {
		border-bottom: 0;
	}

	.metrics__row dt {
		display: inline-flex;
		align-items: baseline;
		gap: 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--mute);
	}

	.metrics__index {
		color: var(--project-accent, var(--accent));
		font-variant-numeric: tabular-nums;
	}

	.metrics__label {
		color: var(--mute);
	}

	.metrics__row dd {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1rem, 1.6vw, 1.2rem);
		line-height: 1.45;
		color: var(--ink);
		font-weight: 400;
	}

	@media (max-width: 40em) {
		.metrics__row {
			grid-template-columns: 1fr;
			gap: 0.4rem;
		}
	}
</style>
