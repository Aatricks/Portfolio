---
import type { CollectionEntry } from 'astro:content';
import CaseStudyLayout from './CaseStudyLayout.astro';

const { entry, Content } = Astro.props as {
	entry: CollectionEntry<'work'>;
	Content: any;
};
---

<CaseStudyLayout
	entry={entry}
	Content={Content}
	themeKey="easyreader"
	accent="#2f7a3a"
	accentDark="#7ad88a"
	hint="~/EasyReader/MainActivity.kt"
	galleryColumns="single"
/>

<style is:global>
	.project-page--easyreader .gallery--single .gallery__frame {
		max-width: 22rem;
		margin-inline: auto;
	}
</style>
