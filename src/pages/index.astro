---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';

const work = await getCollection('work');
const featuredProjects = work
	.filter((project) => project.data.featured)
	.sort((a, b) => (a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999));
const additionalProjects = work
	.filter((project) => !project.data.featured && project.data.status !== 'archive')
	.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const coFlagships = featuredProjects.slice(0, 2);
const secondary = featuredProjects.slice(2);

const aboutCredentials = [
	{ label: 'now', value: 'CS engineering', detail: 'Polytech Tours · 2022–27' },
	{ label: 'was', value: 'AI research intern', detail: 'HEC Montréal · Apr–Aug 2026' },
	{ label: 'based', value: 'France', detail: '14 yrs abroad' },
];

// GitHub repos worth listing in the index but without a case study.
const externalProjects = [
	{
		title: 'Android-battery-optimizer',
		stack: 'Python / ADB / Android',
		href: 'https://github.com/Aatricks/Android-battery-optimizer',
	},
	{
		title: 'Atoll',
		stack: 'Swift / macOS',
		href: 'https://github.com/Aatricks/Atoll',
	},
	{
		title: 'NixOS-EasyConfig',
		stack: 'Nix / flakes',
		href: 'https://github.com/Aatricks/NixOS-EasyConfig',
	},
];


---

<BaseLayout
	title="Emilio Melis · projects"
	description="Projects by Emilio Melis. Android, Rust, C, research. Most of it runs locally."
>
	{/* ============================== §00 · HERO ============================== */}
	<section class="hero" id="top" aria-labelledby="hero-title">
		<div class="hero__bg" aria-hidden="true" data-parallax="0.05"></div>
		<span class="hero__reg hero__reg--tr" aria-hidden="true">+</span>
		<span class="hero__reg hero__reg--bl" aria-hidden="true">+</span>

		<div class="wrapper hero__inner" data-reveal-stagger>
			<div class="hero__main">
				<h1 class="hero__title" id="hero-title" data-reveal>
					I build things I want,<br />
					need, or find <em class="hero__title-mark"><span class="hero__title-text">cool</span><svg
							class="hero__title-stroke"
							viewBox="0 0 320 18"
							aria-hidden="true"
							preserveAspectRatio="none"
						><path
								d="M3 13 C 38 4, 84 15, 128 9 C 172 4, 218 17, 262 11 C 286 8, 302 14, 318 5"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
							/></svg></em>.
				</h1>
				<p class="hero__lede" data-reveal>
					Most of it runs locally.
				</p>

				<div class="hero__actions" data-reveal>
					<a class="btn btn--solid" href="#work">
						<span>Work</span>
						<span aria-hidden="true">→</span>
					</a>
					<a class="btn btn--ghost" href="/Portfolio/CV-English.pdf">
						<span>CV</span>
						<span aria-hidden="true">↓</span>
					</a>
				</div>
			</div>
		</div>
	</section>

	{/* ============================== §01 · WORK ============================== */}
	<section class="section" id="work" aria-labelledby="work-title">
		<div class="wrapper">
			<header class="section__head" data-reveal>
				<p class="section-marker">01 · selected work</p>
				<h2 id="work-title" class="section__title">
					Things I've <em>built</em>.
				</h2>
			</header>

			<div id="selected-work" class="work">
				{coFlagships.length > 0 && (
					<div class="work__coflagship" data-reveal-stagger>
						{coFlagships.map((project) => (
							<PortfolioPreview
								project={project}
								variant="coflagship"
							/>
						))}
					</div>
				)}

				{secondary.length > 0 && (
					<div class="secondary-grid work__secondary" data-reveal-stagger>
						{secondary.map((project) => (
							<PortfolioPreview
								project={project}
								variant="secondary"
							/>
						))}
					</div>
				)}
			</div>
		</div>
	</section>

	{/* ============================== §02 · ABOUT ============================== */}
	<section class="section section--about" id="about" aria-labelledby="about-title">
		<div class="wrapper about">
			<header class="section__head" data-reveal>
				<p class="section-marker">02 · about</p>
				<h2 id="about-title" class="section__title">
					CS engineering at <em>Polytech&nbsp;Tours</em>,<br />
					a research internship at <em>HEC&nbsp;Montréal</em> in 2026.
				</h2>
			</header>

			<div class="about__grid">
				<div class="about__prose" data-reveal>
					<p class="about__lead">
						I build out of curiosity, or to get rid of a problem that's bugging me,
						and most of it ends up being about running heavy compute locally.
					</p>

					<p class="about__body">
						It started with small stuff, a chess engine in C and the controls for an
						autonomous submarine, then kept drifting toward local AI. That's the work I
						care about most: <strong>LightDiffusion</strong>, a Stable Diffusion backend I
						wrote for speed (2.8 it/s where ComfyUI does 1.4), and <strong>llmedge</strong>, an Android
						library that runs LLMs, diffusion, and speech on the phone (on Maven Central, maintained on issues). The rest
						tends to come from everyday friction: <strong>Emaki</strong> because I wanted a better
						reader, with the summaries running on-device (the one I still actively maintain), and <strong>FrameLimiter</strong> because I was
						tired of my Air cooking itself in games. <strong>Pilotrs</strong> is a flight
						simulator core I wrote in Rust to play with control loops: keeping a relaxed-stability
						airframe (which stalls in 0.3 seconds on its own) airborne using noisy sensor
						estimates rather than clean simulator state.
					</p>

					<dl class="about__creds">
						{aboutCredentials.map((c) => (
							<div class="about__cred">
								<dt>{c.label}</dt>
								<dd>
									<span class="about__cred-value">{c.value}</span>
									<span class="about__cred-detail">{c.detail}</span>
								</dd>
							</div>
						))}
					</dl>

					<p class="about__spark">
						off the clock · <strong>top 0.03% EU in Valorant · Model UN (C-MIMUN)</strong>
					</p>
				</div>
			</div>
		</div>
	</section>

	{/* ============================== §03 · INDEX ============================== */}
	<section class="section" id="more" aria-labelledby="more-title">
		<div class="wrapper">
			<header class="section__head" data-reveal>
				<p class="section-marker">03 · index</p>
				<h2 id="more-title" class="section__title">
					More work <em>worth a look</em>.
				</h2>
			</header>

			<ul class="project-index" data-reveal-stagger>
				{additionalProjects.map((project, i) => (
					<li class="project-index__row" data-reveal>
						<a href={`/Portfolio/work/${project.id}`} class="project-index__link">
							<span class="project-index__num">{String(i + 1).padStart(2, '0')}</span>
							<h3 class="project-index__title">{project.data.title}</h3>
							<span class="project-index__stack">{project.data.blurb ?? project.data.stackLine}</span>
							<span class="project-index__arrow" aria-hidden="true">→</span>
						</a>
					</li>
				))}
				{externalProjects.map((project, i) => (
					<li class="project-index__row" data-reveal>
						<a
							href={project.href}
							class="project-index__link"
							target="_blank"
							rel="noopener noreferrer"
						>
							<span class="project-index__num">
								{String(additionalProjects.length + i + 1).padStart(2, '0')}
							</span>
							<h3 class="project-index__title">{project.title}</h3>
							<span class="project-index__stack">{project.stack}</span>
							<span class="project-index__arrow" aria-hidden="true">↗</span>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>
</BaseLayout>



<style>
	/* ====================== HERO ====================== */
	.hero {
		position: relative;
		padding-block: clamp(5rem, 11vw, 9rem) clamp(4rem, 8vw, 7rem);
		min-height: calc(100svh - 4rem);
		display: flex;
		flex-direction: column;
		justify-content: center;
		overflow: clip;
		border-bottom: 1px solid var(--rule-soft);
	}

	.hero__bg {
		position: absolute;
		inset: -10vh -10vw auto auto;
		width: 60vw;
		height: 60vw;
		max-width: 720px;
		max-height: 720px;
		background: radial-gradient(
			closest-side,
			color-mix(in srgb, var(--accent) 8%, transparent),
			transparent 70%
		);
		pointer-events: none;
		filter: blur(48px);
		opacity: 0.55;
		will-change: transform;
	}

	[data-theme='dark'] .hero__bg {
		opacity: 0.4;
	}

	.hero__inner {
		position: relative;
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		max-width: 56rem;
	}

	/* Registration marks: print-shop corners, quiet aesthetic signature */
	.hero__reg {
		position: absolute;
		font-family: var(--font-mono);
		font-size: 0.9rem;
		font-weight: 400;
		color: var(--mute-soft);
		pointer-events: none;
		user-select: none;
	}

	.hero__reg--tr {
		top: clamp(1.5rem, 4vw, 3rem);
		right: clamp(1.25rem, 3.5vw, 2.4rem);
	}

	.hero__reg--bl {
		bottom: clamp(1.5rem, 4vw, 3rem);
		left: clamp(1.25rem, 3.5vw, 2.4rem);
	}

	.hero__title {
		font-family: var(--font-display);
		font-size: clamp(3rem, 9vw, 6.6rem);
		font-weight: 400;
		font-variation-settings: 'opsz' 144, 'SOFT' 30, 'WONK' 1;
		letter-spacing: -0.028em;
		line-height: 0.94;
		max-width: 18ch;
		margin-bottom: 2.2rem;
	}

	.hero__title em {
		color: var(--accent);
		font-style: italic;
		font-variation-settings: 'opsz' 144, 'SOFT' 90, 'WONK' 1;
		transition: font-variation-settings 420ms var(--ease);
	}

	.hero__title em:hover {
		font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1;
	}

	.hero__title-mark {
		position: relative;
		display: inline-block;
		isolation: isolate;
	}

	.hero__title-stroke {
		position: absolute;
		left: -2%;
		right: -2%;
		bottom: -0.18em;
		width: 104%;
		height: 0.32em;
		color: var(--accent);
		opacity: 0.85;
		pointer-events: none;
		overflow: visible;
	}

	.hero__title-stroke path {
		stroke-dasharray: 360;
		stroke-dashoffset: 360;
		transition: stroke-dashoffset 1100ms var(--ease) 320ms;
	}

	:global(.js [data-reveal].is-visible) .hero__title-stroke path {
		stroke-dashoffset: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__title-stroke path {
			stroke-dashoffset: 0;
			transition: none;
		}
	}

	.hero__lede {
		max-width: 38rem;
		font-size: clamp(1.05rem, 1.6vw, 1.2rem);
		line-height: 1.65;
		color: var(--ink-soft);
		margin-bottom: 2rem;
	}

	.hero__lede strong {
		color: var(--ink);
		font-weight: 500;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.78rem 1.1rem;
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.08em;
		text-transform: lowercase;
		border: 1px solid var(--ink);
		transition:
			background-color var(--t-link) var(--ease),
			color var(--t-link) var(--ease),
			transform var(--t-link) var(--ease);
	}

	.btn--solid {
		background: var(--ink);
		color: var(--paper);
	}

	.btn--solid:hover {
		background: var(--accent);
		border-color: var(--accent);
	}

	.btn--ghost {
		background: transparent;
		color: var(--ink);
		border-color: var(--rule);
	}

	.btn--ghost:hover {
		border-color: var(--ink);
		color: var(--accent);
	}

	/* ====================== SECTION ====================== */
	.section {
		padding-block: clamp(4rem, 9vw, 8rem);
		position: relative;
	}

	.section--about {
		background: var(--paper-soft);
		border-block: 1px solid var(--rule);
	}

	/* About is a single narrative column, centered in the wide section. */
	.section--about .about__grid {
		max-width: 42rem;
		margin-inline: auto;
	}

	.section--about .about__prose {
		max-width: none;
	}

	.section--about .about__lead {
		max-width: none;
		text-align: center;
	}

	.section__head {
		display: grid;
		gap: 1.4rem;
		margin-bottom: 3rem;
		max-width: 56rem;
		margin-inline: auto;
		justify-items: center;
		text-align: center;
	}

	.section__title {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3.6rem);
		line-height: 1.04;
		font-weight: 400;
		letter-spacing: -0.022em;
	}

	.section__title em {
		color: var(--accent);
		font-style: italic;
	}

	.section__title-row {
		display: grid;
		gap: 1.25rem;
	}

	.section__lede {
		max-width: 36rem;
		color: var(--ink-soft);
		font-size: 1.02rem;
		line-height: 1.65;
	}

	/* ====================== WORK ====================== */
	.work {
		display: grid;
		gap: 0;
	}

	/* Two co-flagships share the top row: stacked on mobile, side by side on wide. */
	.work__coflagship {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0;
	}

	.work__secondary {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0;
		border-top: 1px solid var(--rule);
	}

	@media (min-width: 64em) {
		.work__coflagship {
			grid-template-columns: 1fr 1fr;
			column-gap: 3rem;
		}
	}

	/* ====================== ABOUT ====================== */
	.about__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		align-items: start;
	}

	.about__prose {
		display: grid;
		gap: 1.6rem;
		max-width: 44rem;
		color: var(--ink-soft);
	}

	.about__lead {
		font-family: var(--font-body);
		font-size: clamp(1.1rem, 1.6vw, 1.22rem);
		font-weight: 500;
		line-height: 1.5;
		letter-spacing: -0.005em;
		color: var(--ink);
		max-width: 34rem;
	}

	.about__body {
		max-width: 36rem;
		font-size: 1.02rem;
		line-height: 1.65;
		color: var(--ink-soft);
	}

	.about__body strong {
		font-weight: 500;
		color: var(--ink);
	}

	.about__creds {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		margin: 0;
		padding-top: 1.4rem;
		border-top: 1px solid var(--rule);
	}

	.about__cred {
		margin: 0;
	}

	.about__cred dt {
		font-family: var(--font-mono);
		color: var(--accent);
		text-transform: uppercase;
		font-size: 0.66rem;
		letter-spacing: 0.16em;
		margin-bottom: 0.45rem;
	}

	.about__cred dd {
		margin: 0;
		display: grid;
		gap: 0.15rem;
	}

	.about__cred-value {
		font-size: 0.92rem;
		line-height: 1.3;
		color: var(--ink);
	}

	.about__cred-detail {
		font-size: 0.82rem;
		line-height: 1.3;
		color: var(--mute);
	}

	.about__spark {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.02em;
		line-height: 1.5;
		color: var(--mute);
	}

	.about__spark strong {
		font-weight: 400;
		color: var(--ink-soft);
	}



	/* ====================== PROJECT INDEX ====================== */
	.project-index {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--rule);
	}

	.project-index__row {
		border-bottom: 1px solid var(--rule);
	}

	.project-index__link {
		display: grid;
		grid-template-columns: auto 1fr auto auto;
		align-items: center;
		gap: 1.2rem 2rem;
		padding-block: 1.4rem;
		padding-inline: 1rem;
		margin-inline: -1rem;
		border-radius: 4px;
		color: var(--ink);
		position: relative;
		transition: background-color var(--t-link) var(--ease);
	}

	.project-index__link::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		width: 0;
		height: 100%;
		background: var(--accent);
		opacity: 0;
		border-radius: 4px 0 0 4px;
		transition: width var(--t-link) var(--ease), opacity var(--t-link) var(--ease);
	}

	.project-index__link:hover::before {
		width: 3px;
		opacity: 1;
	}

	.project-index__link:hover {
		background: color-mix(in srgb, var(--paper-soft) 60%, transparent);
	}

	.project-index__link:hover .project-index__title {
		color: var(--accent);
	}

	.project-index__num {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--mute);
		letter-spacing: 0.08em;
		font-variant-numeric: tabular-nums;
	}

	.project-index__title {
		font-family: var(--font-display);
		font-size: clamp(1.3rem, 2.2vw, 1.8rem);
		font-weight: 400;
		letter-spacing: -0.015em;
		color: var(--ink);
		line-height: 1.1;
	}

	.project-index__stack {
		display: none;
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: var(--ink-soft);
		text-align: right;
		max-width: 34rem;
	}



	.project-index__arrow {
		font-family: var(--font-mono);
		color: var(--mute);
		font-size: 1rem;
		transition: transform var(--t-link) var(--ease), color var(--t-link) var(--ease);
	}

	.project-index__link:hover .project-index__arrow {
		color: var(--accent);
		transform: translateX(4px);
	}

	@media (min-width: 40em) {
		.about__creds {
			grid-template-columns: repeat(3, 1fr);
			gap: 0;
		}

		.about__cred + .about__cred {
			padding-left: 1.25rem;
			border-left: 1px solid var(--rule);
		}

		.about__cred:not(:last-child) {
			padding-right: 1.25rem;
		}
	}

	@media (min-width: 64em) {
		.project-index__link {
			grid-template-columns: auto 1fr auto auto auto;
		}

		.project-index__stack {
			display: inline;
		}
	}
</style>
