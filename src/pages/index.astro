---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import StackInventory from '../components/StackInventory.astro';

const work = await getCollection('work');
const featuredProjects = work
	.filter((project) => project.data.featured)
	.sort((a, b) => (a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999));
const additionalProjects = work
	.filter((project) => !project.data.featured && project.data.status !== 'archive')
	.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const flagship = featuredProjects[0];
const secondary = featuredProjects.slice(1);

const buildDate = new Date().toISOString().slice(0, 10);
const buildHash = buildDate.replace(/-/g, '').slice(2);

const heroSpecs = [
	['LOC', 'Tours, FR · 47.39°N 0.69°E'],
	['BUILD', `${buildDate} · #${buildHash}`],
	['STATUS', 'open to roles · summer 2026'],
];

const aboutFacts = [
	{ label: 'now', value: 'CS engineering @ Polytech Tours · 2022–2027' },
	{ label: 'next', value: 'AI research intern · HEC Montréal · summer 2026' },
	{ label: 'focus', value: 'edge inference · embedded · sensor fusion · ADAS' },
	{ label: 'origin', value: '14 yrs expatriation · 5 spoken languages' },
];

const sideNotes = [
	{ mark: '⌘', text: 'rank-up to Top 0.03% EU in Valorant. asymmetric decisions, team coord under pressure.' },
	{ mark: '∴', text: 'maintain my own NixOS flakes and an arch laptop. kernel troubleshooting included.' },
	{ mark: '⌂', text: '3D printing — machine maintenance + functional parts for embedded projects.' },
	{ mark: 'λ', text: 'fr / en / es / it / ru — diplomacy training at C-MIMUN.' },
];

const codeSnippet = [
	'// llmedge — backend selection',
	'val edge = LLMEdge.create(',
	'    context = ctx,',
	'    scope   = viewModelScope,',
	')',
	'',
	'val reply = edge.text.generate(',
	'    prompt = "summarize edge AI",',
	')',
	'// runs on OpenCL → Vulkan → CPU',
];
---

<BaseLayout
	title="Emilio Melis · edge AI & native systems"
	description="CS engineering student building edge AI runtimes, native systems, and low-level software for constrained hardware."
>
	{/* ============================== §00 · HERO ============================== */}
	<section class="hero" id="top" aria-labelledby="hero-title">
		<div class="hero__canvas" aria-hidden="true">
			<div class="hero__grid"></div>
			<div class="hero__ascii">
				<pre>{`+----+----+----+----+----+----+
|    |    |    |    |    |    |
+----+----+----+----+----+----+
|    |  ●  |    |    |    |    |
+----+----+----+----+----+----+
|    |    |    |    |  ○  |    |
+----+----+----+----+----+----+`}</pre>
			</div>
			<svg class="hero__arc" viewBox="0 0 600 600" aria-hidden="true">
				<defs>
					<linearGradient id="arc-grad" x1="0" y1="0" x2="1" y2="1">
						<stop offset="0%" stop-color="currentColor" stop-opacity="0.2" />
						<stop offset="100%" stop-color="currentColor" stop-opacity="0" />
					</linearGradient>
				</defs>
				<circle cx="300" cy="300" r="280" fill="none" stroke="url(#arc-grad)" stroke-width="1" />
				<circle cx="300" cy="300" r="220" fill="none" stroke="url(#arc-grad)" stroke-width="1" />
				<circle cx="300" cy="300" r="160" fill="none" stroke="currentColor" stroke-opacity="0.08" stroke-width="1" />
			</svg>
		</div>

		<div class="wrapper hero__inner">
			<div class="hero__strip" data-reveal>
				{heroSpecs.map(([k, v], i) => (
					<span class="hero__spec">
						<span class="hero__spec-key">{k}</span>
						<span class="hero__spec-val">{v}</span>
						{i < heroSpecs.length - 1 && <span class="hero__spec-sep" aria-hidden="true">·</span>}
					</span>
				))}
			</div>

			<div class="hero__main" data-reveal>
				<p class="hero__eyebrow">
					<span aria-hidden="true">[ §00 · whoami ]</span>
				</p>
				<h1 class="hero__title" id="hero-title">
					Emilio&nbsp;Melis<span class="hero__cursor" aria-hidden="true">_</span><br />
					builds <em>edge&nbsp;AI</em> that<br />
					runs <em>where it&nbsp;lives</em>.
				</h1>
				<p class="hero__lede">
					Engineering student specializing in algorithmic optimization and AI on constrained
					hardware. I write the C/C++ that makes models fit, the Kotlin/JNI that ships them,
					and the sensor fusion that keeps them honest.
				</p>

				<div class="hero__actions">
					<a class="btn btn--solid" href="#work">
						<span>Selected work</span>
						<span aria-hidden="true">→</span>
					</a>
					<a class="btn btn--ghost" href="https://github.com/Aatricks" target="_blank" rel="noopener noreferrer">
						<span>github.com/Aatricks</span>
						<span aria-hidden="true">↗</span>
					</a>
					<a class="btn btn--ghost" href="/Portfolio/CV-English.pdf">
						<span>CV.pdf</span>
						<span aria-hidden="true">↓</span>
					</a>
				</div>
			</div>

			<aside class="hero__side" data-reveal>
				<div class="hero__terminal" aria-hidden="true">
					<header class="hero__terminal-head">
						<span class="hero__terminal-dot"></span>
						<span class="hero__terminal-dot"></span>
						<span class="hero__terminal-dot"></span>
						<span class="hero__terminal-title">~/llmedge — kotlin</span>
					</header>
					<pre class="hero__terminal-body">{codeSnippet.join('\n')}</pre>
				</div>
			</aside>
		</div>

		<div class="hero__scroll" aria-hidden="true">
			<span>scroll</span>
			<span class="hero__scroll-bar"></span>
		</div>
	</section>

	{/* ============================== §01 · WORK ============================== */}
	<section class="section" id="work" aria-labelledby="work-title">
		<div class="wrapper">
			<header class="section__head" data-reveal>
				<p class="section-marker">§ 01 · selected work</p>
				<div class="section__title-row">
					<h2 id="work-title" class="section__title">
						Systems I built and <em>shipped</em>.
					</h2>
					<p class="section__lede">
						Four projects that map the surface I work across: native runtimes, generation
						stacks, Android product, and engine-level C. Each one is the proof for a specific
						claim on the CV.
					</p>
				</div>
			</header>

			<div id="selected-work" class="work">
				{flagship && (
					<div class="work__flagship">
						<PortfolioPreview project={flagship} variant="dominant" />
					</div>
				)}

				{secondary.length > 0 && (
					<div class="secondary-grid work__secondary">
						{secondary.map((project) => (
							<PortfolioPreview project={project} variant="secondary" />
						))}
					</div>
				)}
			</div>
		</div>
	</section>

	{/* ============================== §02 · ABOUT ============================== */}
	<section class="section section--about" id="about" aria-labelledby="about-title">
		<div class="wrapper about">
			<header class="section__head" data-reveal>
				<p class="section-marker">§ 02 · about</p>
				<h2 id="about-title" class="section__title">
					CS engineering student at <em>Polytech&nbsp;Tours</em>,<br />
					going deep on <em>edge inference</em> and <em>embedded&nbsp;control</em>.
				</h2>
			</header>

			<div class="about__grid">
				<div class="about__prose" data-reveal>
					<p>
						I build software that runs locally — under tight memory, on heterogeneous
						hardware, with backends that fail differently on every device. My recent work
						sits at the seam between <strong>native runtimes</strong> (C/C++, JNI, Vulkan)
						and the <strong>product layers</strong> that ship them.
					</p>
					<p>
						Before AI took over my repo list, the same instinct showed up in signal
						processing: a navigation stack for an autonomous submarine, with mathematically
						implemented Kalman filters fusing raw IMU data into a heading I could trust.
						That, more than any model, is what I want to keep doing.
					</p>
					<p>
						Aerospace, automotive, ADAS — anywhere the runtime has to be honest about the
						hardware. That is where I want this work to land.
					</p>

					<dl class="about__facts">
						{aboutFacts.map((fact) => (
							<div class="about__fact">
								<dt>{fact.label}</dt>
								<dd>{fact.value}</dd>
							</div>
						))}
					</dl>
				</div>

				<aside class="about__notes" data-reveal aria-label="Marginalia">
					<p class="about__notes-label">— marginalia</p>
					{sideNotes.map((note) => (
						<div class="about__note">
							<span class="about__note-mark" aria-hidden="true">{note.mark}</span>
							<p>{note.text}</p>
						</div>
					))}
				</aside>
			</div>
		</div>
	</section>

	{/* ============================== §03 · STACK ============================== */}
	<section class="section" id="stack" aria-labelledby="stack-title">
		<div class="wrapper">
			<header class="section__head" data-reveal>
				<p class="section-marker">§ 03 · stack</p>
				<h2 id="stack-title" class="section__title">
					Tools I reach for, <em>ranked by hours&nbsp;in&nbsp;hand</em>.
				</h2>
			</header>

			<StackInventory />
		</div>
	</section>

	{/* ============================== §05 · MORE WORK ============================== */}
	{additionalProjects.length > 0 && (
		<section class="section" id="more" aria-labelledby="more-title">
			<div class="wrapper">
				<header class="section__head" data-reveal>
					<p class="section-marker">§ 05 · index</p>
					<h2 id="more-title" class="section__title">
						More work <em>worth a look</em>.
					</h2>
				</header>

				<ul class="project-index" data-reveal>
					{additionalProjects.map((project, i) => (
						<li class="project-index__row">
							<a href={`/Portfolio/work/${project.id}`} class="project-index__link">
								<span class="project-index__num">{String(i + 1).padStart(2, '0')}</span>
								<div class="project-index__copy">
									<p class="project-index__eyebrow">{project.data.eyebrow}</p>
									<h3 class="project-index__title">{project.data.title}</h3>
								</div>
								<span class="project-index__stack">{project.data.stackLine}</span>
								<span class="project-index__arrow" aria-hidden="true">→</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>
	)}
</BaseLayout>

<style>
	/* ====================== HERO ====================== */
	.hero {
		position: relative;
		padding-block: 4rem 3rem;
		min-height: calc(100svh - 4rem);
		display: flex;
		flex-direction: column;
		justify-content: center;
		overflow: clip;
		border-bottom: 1px solid var(--rule-soft);
	}

	.hero__canvas {
		position: absolute;
		inset: 0;
		pointer-events: none;
		color: var(--accent);
		opacity: 0.75;
	}

	.hero__grid {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(to right, var(--rule-soft) 1px, transparent 1px),
			linear-gradient(to bottom, var(--rule-soft) 1px, transparent 1px);
		background-size: clamp(40px, 6vw, 88px) clamp(40px, 6vw, 88px);
		mask-image: radial-gradient(ellipse at top right, rgba(0, 0, 0, 0.55), transparent 70%);
		opacity: 0.7;
	}

	.hero__ascii {
		position: absolute;
		top: 50%;
		right: -2rem;
		transform: translateY(-50%);
		font-family: var(--font-mono);
		font-size: 0.6rem;
		color: var(--mute);
		opacity: 0.25;
		display: none;
	}

	.hero__arc {
		position: absolute;
		right: -8rem;
		top: -8rem;
		width: 36rem;
		height: 36rem;
		color: var(--accent);
		opacity: 0.55;
	}

	.hero__inner {
		position: relative;
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		padding-top: 1.5rem;
	}

	.hero__strip {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		align-items: baseline;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		color: var(--mute);
		text-transform: lowercase;
	}

	.hero__spec {
		display: inline-flex;
		gap: 0.4rem;
		align-items: baseline;
	}

	.hero__spec-key {
		color: var(--accent);
		font-weight: 500;
		letter-spacing: 0.08em;
	}

	.hero__spec-val {
		color: var(--ink-soft);
	}

	.hero__spec-sep {
		color: var(--mute-soft);
		margin-inline: 0.2rem;
	}

	.hero__eyebrow {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		color: var(--mute);
		margin-bottom: 1.2rem;
		text-transform: lowercase;
	}

	.hero__title {
		font-family: var(--font-display);
		font-size: clamp(3rem, 9vw, 6.6rem);
		font-weight: 400;
		font-variation-settings: 'opsz' 144, 'SOFT' 30, 'WONK' 1;
		letter-spacing: -0.028em;
		line-height: 0.94;
		max-width: 16ch;
		margin-bottom: 2rem;
	}

	.hero__title em {
		color: var(--accent);
		font-style: italic;
		font-variation-settings: 'opsz' 144, 'SOFT' 90, 'WONK' 1;
	}

	.hero__cursor {
		display: inline-block;
		color: var(--accent);
		font-style: normal;
		font-family: var(--font-mono);
		font-size: 0.7em;
		font-weight: 400;
		transform: translateY(-0.18em);
		margin-left: 0.05em;
		animation: blink 1.05s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.hero__lede {
		max-width: 38rem;
		font-size: clamp(1.05rem, 1.6vw, 1.2rem);
		line-height: 1.65;
		color: var(--ink-soft);
		margin-bottom: 2rem;
	}

	.hero__lede strong {
		color: var(--ink);
		font-weight: 500;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.78rem 1.1rem;
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.08em;
		text-transform: lowercase;
		border: 1px solid var(--ink);
		transition:
			background-color 220ms var(--ease),
			color 220ms var(--ease),
			transform 220ms var(--ease);
	}

	.btn--solid {
		background: var(--ink);
		color: var(--paper);
	}

	.btn--solid:hover {
		background: var(--accent);
		border-color: var(--accent);
		transform: translateY(-1px);
	}

	.btn--ghost {
		background: transparent;
		color: var(--ink);
		border-color: var(--rule);
	}

	.btn--ghost:hover {
		border-color: var(--ink);
		color: var(--accent);
	}

	.hero__side {
		display: none;
	}

	.hero__terminal {
		border: 1px solid var(--rule);
		background: var(--paper-soft);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		line-height: 1.55;
		overflow: hidden;
		box-shadow: 0 1px 0 var(--rule-soft);
	}

	.hero__terminal-head {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.55rem 0.75rem;
		border-bottom: 1px solid var(--rule);
		background: var(--paper-deep);
		font-size: 0.68rem;
		color: var(--mute);
	}

	.hero__terminal-dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 999px;
		background: var(--rule);
	}

	.hero__terminal-title {
		margin-left: auto;
		letter-spacing: 0.05em;
	}

	.hero__terminal-body {
		margin: 0;
		padding: 1rem 1.1rem;
		color: var(--ink-soft);
		white-space: pre;
		overflow-x: auto;
	}

	.hero__scroll {
		position: absolute;
		bottom: 1.5rem;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--mute);
		pointer-events: none;
	}

	.hero__scroll-bar {
		width: 1px;
		height: 2.5rem;
		background: linear-gradient(to bottom, var(--accent), transparent);
		animation: scroll-bar 2s var(--ease) infinite;
	}

	@keyframes scroll-bar {
		0% {
			transform: scaleY(0);
			transform-origin: top;
		}
		50% {
			transform: scaleY(1);
			transform-origin: top;
		}
		51% {
			transform-origin: bottom;
		}
		100% {
			transform: scaleY(0);
			transform-origin: bottom;
		}
	}

	/* ====================== SECTION ====================== */
	.section {
		padding-block: clamp(4rem, 9vw, 8rem);
		position: relative;
	}

	.section--about {
		background: var(--paper-soft);
		border-block: 1px solid var(--rule);
	}

	.section__head {
		display: grid;
		gap: 1.4rem;
		margin-bottom: 3rem;
		max-width: 56rem;
	}

	.section__title {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3.6rem);
		line-height: 1.04;
		font-weight: 400;
		letter-spacing: -0.022em;
	}

	.section__title em {
		color: var(--accent);
		font-style: italic;
	}

	.section__title-row {
		display: grid;
		gap: 1.25rem;
	}

	.section__lede {
		max-width: 36rem;
		color: var(--ink-soft);
		font-size: 1.02rem;
		line-height: 1.65;
	}

	/* ====================== WORK ====================== */
	.work {
		display: grid;
		gap: 0;
	}

	.work__secondary {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0;
		border-top: 1px solid var(--rule);
	}

	/* ====================== ABOUT ====================== */
	.about__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		align-items: start;
	}

	.about__prose {
		display: grid;
		gap: 1.2rem;
		max-width: 44rem;
		font-size: 1.05rem;
		line-height: 1.75;
		color: var(--ink-soft);
	}

	.about__prose p strong {
		color: var(--ink);
		font-weight: 500;
	}

	.about__facts {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.55rem 1.2rem;
		margin: 0;
		padding-top: 1.4rem;
		border-top: 1px dashed var(--rule);
		font-family: var(--font-mono);
		font-size: 0.84rem;
		line-height: 1.55;
	}

	.about__fact {
		display: contents;
	}

	.about__fact dt {
		color: var(--accent);
		text-transform: uppercase;
		font-size: 0.7rem;
		letter-spacing: 0.16em;
		padding-top: 0.2rem;
	}

	.about__fact dd {
		margin: 0;
		color: var(--ink);
	}

	.about__notes {
		position: relative;
		padding: 1.6rem 1.4rem 1.4rem;
		border: 1px solid var(--rule);
		background: var(--paper);
		display: grid;
		gap: 1.1rem;
	}

	.about__notes::before {
		content: '';
		position: absolute;
		top: -1px;
		left: 1.2rem;
		width: 2rem;
		height: 2px;
		background: var(--accent);
	}

	.about__notes-label {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--mute);
	}

	.about__note {
		display: grid;
		grid-template-columns: 1.4rem 1fr;
		gap: 0.7rem;
		font-size: 0.92rem;
		line-height: 1.55;
		color: var(--ink-soft);
	}

	.about__note-mark {
		font-family: var(--font-mono);
		color: var(--accent);
		font-size: 1rem;
		line-height: 1.2;
	}

	/* ====================== PROJECT INDEX ====================== */
	.project-index {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--rule);
	}

	.project-index__row {
		border-bottom: 1px solid var(--rule);
	}

	.project-index__link {
		display: grid;
		grid-template-columns: auto 1fr auto auto;
		align-items: center;
		gap: 1.2rem 2rem;
		padding-block: 1.4rem;
		color: var(--ink);
		position: relative;
	}

	.project-index__link::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		width: 0;
		height: 100%;
		background: var(--accent);
		opacity: 0;
		transition: width 280ms var(--ease), opacity 280ms var(--ease);
	}

	.project-index__link:hover::before {
		width: 3px;
		opacity: 1;
	}

	.project-index__link:hover {
		padding-left: 1rem;
	}

	.project-index__num {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--mute);
		letter-spacing: 0.08em;
		font-variant-numeric: tabular-nums;
	}

	.project-index__copy {
		display: grid;
		gap: 0.25rem;
	}

	.project-index__eyebrow {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
