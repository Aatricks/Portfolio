---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import StackInventory from '../components/StackInventory.astro';

const work = await getCollection('work');
const featuredProjects = work
	.filter((project) => project.data.featured)
	.sort((a, b) => (a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999));
const additionalProjects = work
	.filter((project) => !project.data.featured && project.data.status !== 'archive')
	.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const flagship = featuredProjects[0];
const secondary = featuredProjects.slice(1);

const aboutFacts = [
	{ label: 'now', value: 'CS engineering @ Polytech Tours · 2022–2027' },
	{ label: 'next', value: 'AI research intern · HEC Montréal · summer 2026' },
	{ label: 'origin', value: '14 yrs expatriation · 5 spoken languages' },
];

// GitHub repos worth listing in the index but without a case study.
const externalProjects = [
	{
		title: 'Android-battery-optimizer',
		stack: 'Python / ADB / Android',
		href: 'https://github.com/Aatricks/Android-battery-optimizer',
		repo: 'Android-battery-optimizer',
	},
	{
		title: 'Atoll',
		stack: 'Swift / macOS',
		href: 'https://github.com/Aatricks/Atoll',
		repo: 'Atoll',
	},
	{
		title: 'llmedge-examples',
		stack: 'Kotlin / Android',
		href: 'https://github.com/Aatricks/llmedge-examples',
		repo: 'llmedge-examples',
	},
	{
		title: 'NixOS-EasyConfig',
		stack: 'Nix / flakes',
		href: 'https://github.com/Aatricks/NixOS-EasyConfig',
		repo: 'NixOS-EasyConfig',
	},
];

const sideNotes = [
	{ mark: '⌘', text: 'rank-up to Top 0.03% EU in Valorant. asymmetric decisions, team coord under pressure.' },
	{ mark: '∴', text: 'maintain my own NixOS flakes and an arch laptop. kernel troubleshooting included.' },
	{ mark: '⌂', text: '3D printing — machine maintenance + functional parts for embedded projects.' },
	{ mark: 'λ', text: 'fr / en / es / it / ru — diplomacy training at C-MIMUN.' },
];

// ---- Build-time GitHub activity strip (real contribution data) ----
// Source: jogruber's contributions proxy — real per-day GitHub contribution
// counts (commits + PRs + issues + reviews) with GitHub's own 0–4 levels.
// No token needed; CORS-enabled. The public events API was too sparse to fill
// a 90-day window, so the old strip rendered near-empty (the "placeholder").
const WINDOW_DAYS = 90;
type ContribDay = { date: string; count: number; level: number };
let days: ContribDay[] = [];

try {
	const res = await fetch(
		'https://github-contributions-api.jogruber.de/v4/Aatricks?y=last',
		{
			signal: AbortSignal.timeout(6000),
			headers: { 'user-agent': 'portfolio-build', accept: 'application/json' },
		},
	);
	if (res.ok) {
		const data = (await res.json()) as { contributions?: ContribDay[] };
		if (Array.isArray(data.contributions)) {
			days = data.contributions.slice(-WINDOW_DAYS);
		}
	}
} catch {
	// Network failure or rate limit — fall through to the empty fallback below.
}

// Always render a full window, even if the fetch failed (graceful degradation).
if (days.length === 0) {
	const todayUtc = new Date();
	todayUtc.setUTCHours(0, 0, 0, 0);
	days = Array.from({ length: WINDOW_DAYS }, (_, i) => {
		const d = new Date(todayUtc);
		d.setUTCDate(d.getUTCDate() - (WINDOW_DAYS - 1 - i));
		return { date: d.toISOString().slice(0, 10), count: 0, level: 0 };
	});
}

// GitHub's 5-bucket scale mapped onto the strip's accent opacity.
const LEVEL_OPACITY = [0.08, 0.34, 0.56, 0.78, 1];
const totalContributions = days.reduce((sum, d) => sum + d.count, 0);
const activityGrid = days.map((d) => ({
	date: d.date,
	count: d.count,
	opacity: LEVEL_OPACITY[d.level] ?? 0.08,
}));

let lastActive: string | null = null;
for (let i = days.length - 1; i >= 0; i--) {
	if (days[i].count > 0) {
		lastActive = days[i].date;
		break;
	}
}

function relativeAgo(iso: string | null): string {
	if (!iso) return 'no recent activity';
	const sec = (Date.now() - new Date(iso).getTime()) / 1000;
	if (sec < 86400) return 'today';
	if (sec < 86400 * 7) return `${Math.floor(sec / 86400)}d ago`;
	return `${Math.floor(sec / (86400 * 7))}w ago`;
}
const lastActiveAgo = relativeAgo(lastActive);

// ---- Build-time GitHub repo stats (totals + per-repo star counts) ----
let totalStars = 0;
let totalForks = 0;
const repoStars: Record<string, number> = {};
try {
	const res = await fetch(
		'https://api.github.com/users/Aatricks/repos?per_page=100&type=owner&sort=updated',
		{
			signal: AbortSignal.timeout(6000),
			headers: { 'user-agent': 'portfolio-build', accept: 'application/vnd.github+json' },
		},
	);
	if (res.ok) {
		const repos = (await res.json()) as Array<{
			name?: string;
			stargazers_count?: number;
			forks_count?: number;
		}>;
		if (Array.isArray(repos)) {
			for (const r of repos) {
				totalStars += r.stargazers_count ?? 0;
				totalForks += r.forks_count ?? 0;
				if (r.name) repoStars[r.name] = r.stargazers_count ?? 0;
			}
		}
	}
} catch {
	// Network failure or rate limit — totals stay 0; the client refresh fills them.
}

// Star count for a project from its repo URL (case studies) or repo name (index rows).
const starsFor = (repoUrl: string | undefined): number =>
	repoUrl ? (repoStars[repoUrl.split('/').pop() ?? ''] ?? 0) : 0;
---

<BaseLayout
	title="Emilio Melis · edge AI & native systems"
	description="CS engineering student building edge AI runtimes, native systems, and low-level software for constrained hardware."
>
	{/* ============================== §00 · HERO ============================== */}
	<section class="hero" id="top" aria-labelledby="hero-title">
		<div class="hero__bg" aria-hidden="true" data-parallax="0.05"></div>
		<span class="hero__reg hero__reg--tr" aria-hidden="true">+</span>
		<span class="hero__reg hero__reg--bl" aria-hidden="true">+</span>

		<div class="wrapper hero__inner" data-reveal-stagger>
			<div class="hero__main">
				<h1 class="hero__title" id="hero-title" data-reveal>
					Emilio&nbsp;Melis.<br />
					builds <em>edge&nbsp;AI</em> that<br />
					runs <em class="hero__title-mark"><span class="hero__title-text">where it&nbsp;lives</span><svg
							class="hero__title-stroke"
							viewBox="0 0 320 18"
							aria-hidden="true"
							preserveAspectRatio="none"
						><path
								d="M3 13 C 38 4, 84 15, 128 9 C 172 4, 218 17, 262 11 C 286 8, 302 14, 318 5"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
							/></svg></em>.
				</h1>
				<p class="hero__lede" data-reveal>
					Native runtimes, sensor fusion, AI on constrained hardware.
				</p>

				<div class="hero__actions" data-reveal>
					<a class="btn btn--solid" href="#work">
						<span>Work</span>
						<span aria-hidden="true">→</span>
					</a>
					<a class="btn btn--ghost" href="/Portfolio/CV-English.pdf">
						<span>CV</span>
						<span aria-hidden="true">↓</span>
					</a>
				</div>
			</div>
		</div>
	</section>

	{/* ============================== §01 · WORK ============================== */}
	<section class="section" id="work" aria-labelledby="work-title">
		<div class="wrapper">
			<header class="section__head" data-reveal>
				<p class="section-marker">01 · selected work</p>
				<h2 id="work-title" class="section__title">
					Systems I built and <em>shipped</em>.
				</h2>
			</header>

			<div id="selected-work" class="work">
				{flagship && (
					<div class="work__flagship">
						<PortfolioPreview
							project={flagship}
							variant="dominant"
							stars={starsFor(flagship.data.repoUrl)}
						/>
					</div>
				)}

				{secondary.length > 0 && (
					<div class="secondary-grid work__secondary" data-reveal-stagger>
						{secondary.map((project) => (
							<PortfolioPreview
								project={project}
								variant="secondary"
								stars={starsFor(project.data.repoUrl)}
							/>
						))}
					</div>
				)}
			</div>
		</div>
	</section>

	{/* ============================== §02 · ABOUT ============================== */}
	<section class="section section--about" id="about" aria-labelledby="about-title">
		<div class="wrapper about">
			<header class="section__head" data-reveal>
				<p class="section-marker">02 · about</p>
				<h2 id="about-title" class="section__title">
					CS engineering student at <em>Polytech&nbsp;Tours</em> —<br />
					next, AI research at <em>HEC&nbsp;Montréal</em>.
				</h2>
			</header>

			<div class="about__grid">
				<div class="about__prose" data-reveal>
					<p class="about__pull">
						It started with an autonomous submarine: fusing raw IMU data through
						<strong>Kalman filters</strong> until the heading finally held.
					</p>

					<p class="about__body">
						That control-loop discipline now goes into edge AI — native inference
						runtimes on phones and embedded targets, aimed at automotive and
						aerospace systems where real-time is not optional.
					</p>

					<dl class="about__facts">
						{aboutFacts.map((fact) => (
							<div class="about__fact">
								<dt>{fact.label}</dt>
								<dd>{fact.value}</dd>
							</div>
						))}
					</dl>

					<div class="about__activity" data-reveal aria-label="GitHub activity, last 90 days">
						<div class="about__activity-head">
							<span class="label">last 90 days · github</span>
							<span class="about__activity-meta">
								last active <em data-activity-last>{lastActiveAgo}</em> · <span data-activity-total>{totalContributions}</span> contributions
								· ★ <span data-repo-stars>{totalStars}</span> · ⑂ <span data-repo-forks>{totalForks}</span>
							</span>
						</div>
						<svg class="about__activity-strip" data-activity-strip viewBox={`0 0 ${activityGrid.length * 3} 14`} preserveAspectRatio="none" aria-hidden="true">
							{activityGrid.map((cell, i) => (
								<rect x={i * 3} y={2} width={2} height={10} fill="currentColor" opacity={cell.opacity}>
									<title>{cell.date}: {cell.count} contribution{cell.count === 1 ? '' : 's'}</title>
								</rect>
							))}
						</svg>
						<div class="about__activity-axis" aria-hidden="true">
							<span>90d ago</span>
							<span>today</span>
						</div>
					</div>
				</div>

				<aside class="about__notes" data-reveal aria-label="Side notes">
					{sideNotes.map((note) => (
						<div class="about__note">
							<span class="about__note-mark" aria-hidden="true">{note.mark}</span>
							<p>{note.text}</p>
						</div>
					))}
				</aside>
			</div>
		</div>
	</section>

	{/* ============================== §03 · STACK ============================== */}
	<section class="section" id="stack" aria-labelledby="stack-title">
		<div class="wrapper">
			<header class="section__head" data-reveal>
				<p class="section-marker">03 · stack</p>
				<h2 id="stack-title" class="section__title">
					Tools I reach for, <em>proven by what&nbsp;shipped</em>.
				</h2>
			</header>

			<StackInventory />
		</div>
	</section>

	{/* ============================== §04 · INDEX ============================== */}
	<section class="section" id="more" aria-labelledby="more-title">
		<div class="wrapper">
			<header class="section__head" data-reveal>
				<p class="section-marker">04 · index</p>
				<h2 id="more-title" class="section__title">
					More work <em>worth a look</em>.
				</h2>
			</header>

			<ul class="project-index" data-reveal-stagger>
				{additionalProjects.map((project, i) => (
					<li class="project-index__row" data-reveal>
						<a href={`/Portfolio/work/${project.id}`} class="project-index__link">
							<span class="project-index__num">{String(i + 1).padStart(2, '0')}</span>
							<h3 class="project-index__title">{project.data.title}</h3>
							<span class="project-index__stack">{project.data.blurb ?? project.data.stackLine}</span>
							{starsFor(project.data.repoUrl) > 0 && (
								<span class="project-index__stars">★ {starsFor(project.data.repoUrl)}</span>
							)}
							<span class="project-index__arrow" aria-hidden="true">→</span>
						</a>
					</li>
				))}
				{externalProjects.map((project, i) => (
					<li class="project-index__row" data-reveal>
						<a
							href={project.href}
							class="project-index__link"
							target="_blank"
							rel="noopener noreferrer"
						>
							<span class="project-index__num">
								{String(additionalProjects.length + i + 1).padStart(2, '0')}
							</span>
							<h3 class="project-index__title">{project.title}</h3>
							<span class="project-index__stack">{project.stack}</span>
							{(repoStars[project.repo] ?? 0) > 0 && (
								<span class="project-index__stars">★ {repoStars[project.repo]}</span>
							)}
							<span class="project-index__arrow" aria-hidden="true">↗</span>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>
</BaseLayout>

<script>
	// Progressive enhancement: the strip is rendered with real data at build
	// time, then refreshed live in the browser so it stays current between
	// portfolio redeploys. If the fetch fails, the build-time baseline stays.
	const ACTIVITY_USER = 'Aatricks';
	const ACTIVITY_WINDOW = 90;
	const ACTIVITY_LEVEL_OPACITY = [0.08, 0.34, 0.56, 0.78, 1];
	const SVG_NS = 'http://www.w3.org/2000/svg';

	function activityAgo(dateStr: string | null): string {
		if (!dateStr) return 'no recent activity';
		const sec = (Date.now() - new Date(dateStr).getTime()) / 1000;
		if (sec < 86400) return 'today';
		if (sec < 86400 * 7) return `${Math.floor(sec / 86400)}d ago`;
		return `${Math.floor(sec / (86400 * 7))}w ago`;
	}

	async function refreshActivity() {
		const strip = document.querySelector('[data-activity-strip]');
		if (!strip) return;

		let days: Array<{ date: string; count: number; level: number }>;
		try {
			const res = await fetch(
				`https://github-contributions-api.jogruber.de/v4/${ACTIVITY_USER}?y=last`,
			);
			if (!res.ok) return;
			const data = await res.json();
			if (!Array.isArray(data?.contributions)) return;
			days = data.contributions.slice(-ACTIVITY_WINDOW);
		} catch {
			return; // keep the build-time baseline
		}
		if (!days.length) return;

		const frag = document.createDocumentFragment();
		let total = 0;
		let lastActive: string | null = null;
		days.forEach((d, i) => {
			total += d.count;
			if (d.count > 0) lastActive = d.date;
			const rect = document.createElementNS(SVG_NS, 'rect');
			rect.setAttribute('x', String(i * 3));
			rect.setAttribute('y', '2');
			rect.setAttribute('width', '2');
			rect.setAttribute('height', '10');
			rect.setAttribute('fill', 'currentColor');
			rect.setAttribute('opacity', String(ACTIVITY_LEVEL_OPACITY[d.level] ?? 0.08));
			const title = document.createElementNS(SVG_NS, 'title');
			title.textContent = `${d.date}: ${d.count} contribution${d.count === 1 ? '' : 's'}`;
			rect.appendChild(title);
			frag.appendChild(rect);
		});
		strip.replaceChildren(frag);

		const totalEl = document.querySelector('[data-activity-total]');
		if (totalEl) totalEl.textContent = String(total);
		const lastEl = document.querySelector('[data-activity-last]');
		if (lastEl) lastEl.textContent = activityAgo(lastActive);
	}

	async function refreshRepoStats() {
		const starsEl = document.querySelector('[data-repo-stars]');
		const forksEl = document.querySelector('[data-repo-forks]');
		if (!starsEl && !forksEl) return;

		let repos: Array<{ stargazers_count?: number; forks_count?: number }>;
		try {
			const res = await fetch(
				`https://api.github.com/users/${ACTIVITY_USER}/repos?per_page=100&type=owner&sort=updated`,
				{ headers: { accept: 'application/vnd.github+json' } },
			);
			if (!res.ok) return;
			repos = await res.json();
			if (!Array.isArray(repos)) return;
		} catch {
			return; // keep the build-time baseline
		}

		let stars = 0;
		let forks = 0;
		for (const r of repos) {
			stars += r.stargazers_count ?? 0;
			forks += r.forks_count ?? 0;
		}
		if (starsEl) starsEl.textContent = String(stars);
		if (forksEl) forksEl.textContent = String(forks);
	}

	refreshActivity();
	refreshRepoStats();
</script>

<style>
	/* ====================== HERO ====================== */
	.hero {
		position: relative;
		padding-block: clamp(5rem, 11vw, 9rem) clamp(4rem, 8vw, 7rem);
		min-height: calc(100svh - 4rem);
		display: flex;
		flex-direction: column;
		justify-content: center;
		overflow: clip;
		border-bottom: 1px solid var(--rule-soft);
	}

	.hero__bg {
		position: absolute;
		inset: -10vh -10vw auto auto;
		width: 60vw;
		height: 60vw;
		max-width: 720px;
		max-height: 720px;
		background: radial-gradient(
			closest-side,
			color-mix(in srgb, var(--accent) 8%, transparent),
			transparent 70%
		);
		pointer-events: none;
		filter: blur(48px);
		opacity: 0.55;
		will-change: transform;
	}

	[data-theme='dark'] .hero__bg {
		opacity: 0.4;
	}

	.hero__inner {
		position: relative;
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		max-width: 56rem;
	}

	/* Registration marks — print-shop corners, quiet aesthetic signature */
	.hero__reg {
		position: absolute;
		font-family: var(--font-mono);
		font-size: 0.9rem;
		font-weight: 400;
		color: var(--mute-soft);
		pointer-events: none;
		user-select: none;
	}

	.hero__reg--tr {
		top: clamp(1.5rem, 4vw, 3rem);
		right: clamp(1.25rem, 3.5vw, 2.4rem);
	}

	.hero__reg--bl {
		bottom: clamp(1.5rem, 4vw, 3rem);
		left: clamp(1.25rem, 3.5vw, 2.4rem);
	}

	.hero__title {
		font-family: var(--font-display);
		font-size: clamp(3rem, 9vw, 6.6rem);
		font-weight: 400;
		font-variation-settings: 'opsz' 144, 'SOFT' 30, 'WONK' 1;
		letter-spacing: -0.028em;
		line-height: 0.94;
		max-width: 18ch;
		margin-bottom: 2.2rem;
	}

	.hero__title em {
		color: var(--accent);
		font-style: italic;
		font-variation-settings: 'opsz' 144, 'SOFT' 90, 'WONK' 1;
		transition: font-variation-settings 420ms var(--ease);
	}

	.hero__title em:hover {
		font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1;
	}

	.hero__title-mark {
		position: relative;
		display: inline-block;
		isolation: isolate;
	}

	.hero__title-stroke {
		position: absolute;
		left: -2%;
		right: -2%;
		bottom: -0.18em;
		width: 104%;
		height: 0.32em;
		color: var(--accent);
		opacity: 0.85;
		pointer-events: none;
		overflow: visible;
	}

	.hero__title-stroke path {
		stroke-dasharray: 360;
		stroke-dashoffset: 360;
		transition: stroke-dashoffset 1100ms var(--ease) 320ms;
	}

	:global(.js [data-reveal].is-visible) .hero__title-stroke path {
		stroke-dashoffset: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__title-stroke path {
			stroke-dashoffset: 0;
			transition: none;
		}
	}

	.hero__lede {
		max-width: 38rem;
		font-size: clamp(1.05rem, 1.6vw, 1.2rem);
		line-height: 1.65;
		color: var(--ink-soft);
		margin-bottom: 2rem;
	}

	.hero__lede strong {
		color: var(--ink);
		font-weight: 500;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.78rem 1.1rem;
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.08em;
		text-transform: lowercase;
		border: 1px solid var(--ink);
		transition:
			background-color var(--t-link) var(--ease),
			color var(--t-link) var(--ease),
			transform var(--t-link) var(--ease);
	}

	.btn--solid {
		background: var(--ink);
		color: var(--paper);
	}

	.btn--solid:hover {
		background: var(--accent);
		border-color: var(--accent);
	}

	.btn--ghost {
		background: transparent;
		color: var(--ink);
		border-color: var(--rule);
	}

	.btn--ghost:hover {
		border-color: var(--ink);
		color: var(--accent);
	}

	/* ====================== SECTION ====================== */
	.section {
		padding-block: clamp(4rem, 9vw, 8rem);
		position: relative;
	}

	.section--about {
		background: var(--paper-soft);
		border-block: 1px solid var(--rule);
	}

	.section__head {
		display: grid;
		gap: 1.4rem;
		margin-bottom: 3rem;
		max-width: 56rem;
	}

	.section__title {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3.6rem);
		line-height: 1.04;
		font-weight: 400;
		letter-spacing: -0.022em;
	}

	.section__title em {
		color: var(--accent);
		font-style: italic;
	}

	.section__title-row {
		display: grid;
		gap: 1.25rem;
	}

	.section__lede {
		max-width: 36rem;
		color: var(--ink-soft);
		font-size: 1.02rem;
		line-height: 1.65;
	}

