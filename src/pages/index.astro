---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import StackInventory from '../components/StackInventory.astro';

const work = await getCollection('work');
const featuredProjects = work
	.filter((project) => project.data.featured)
	.sort((a, b) => (a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999));
const additionalProjects = work
	.filter((project) => !project.data.featured && project.data.status !== 'archive')
	.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const flagship = featuredProjects[0];
const secondary = featuredProjects.slice(1);

const aboutFacts = [
	{ label: 'now', value: 'CS engineering @ Polytech Tours · 2022–2027' },
	{ label: 'next', value: 'AI research intern · HEC Montréal · summer 2026' },
	{ label: 'focus', value: 'edge inference · embedded · sensor fusion · ADAS' },
	{ label: 'origin', value: '14 yrs expatriation · 5 spoken languages' },
];

const sideNotes = [
	{ mark: '⌘', text: 'rank-up to Top 0.03% EU in Valorant. asymmetric decisions, team coord under pressure.' },
	{ mark: '∴', text: 'maintain my own NixOS flakes and an arch laptop. kernel troubleshooting included.' },
	{ mark: '⌂', text: '3D printing — machine maintenance + functional parts for embedded projects.' },
	{ mark: 'λ', text: 'fr / en / es / it / ru — diplomacy training at C-MIMUN.' },
];

// ---- Build-time GitHub activity strip ----
const NINETY_DAYS = 91;
const todayUtc = new Date();
todayUtc.setUTCHours(0, 0, 0, 0);
const ninetyDays = Array.from({ length: NINETY_DAYS }, (_, i) => {
	const d = new Date(todayUtc);
	d.setUTCDate(d.getUTCDate() - (NINETY_DAYS - 1 - i));
	return d.toISOString().slice(0, 10);
});
const counts = new Map<string, number>(ninetyDays.map((d) => [d, 0]));
let totalCommits = 0;
let lastPushed: string | null = null;

try {
	const res = await fetch(
		'https://api.github.com/users/Aatricks/events/public?per_page=100',
		{
			signal: AbortSignal.timeout(5000),
			headers: { 'user-agent': 'portfolio-build', accept: 'application/vnd.github+json' },
		},
	);
	if (res.ok) {
		const events = (await res.json()) as Array<any>;
		for (const e of events) {
			if (e?.type !== 'PushEvent') continue;
			// public events strip the commits array; fall back to size or 1
			const commitCount =
				(Array.isArray(e?.payload?.commits) && e.payload.commits.length) ||
				(typeof e?.payload?.size === 'number' && e.payload.size) ||
				1;
			const day = String(e.created_at).slice(0, 10);
			const prev = counts.get(day);
			if (prev !== undefined) {
				counts.set(day, prev + commitCount);
				totalCommits += commitCount;
				if (!lastPushed || e.created_at > lastPushed) {
					lastPushed = e.created_at;
				}
			}
		}
	}
} catch {
	// Network failure or rate limit — strip renders empty (still informative).
}

const maxCount = Math.max(1, ...Array.from(counts.values()));
const activityGrid = ninetyDays.map((d) => {
	const c = counts.get(d) ?? 0;
	return {
		date: d,
		count: c,
		opacity: c === 0 ? 0.08 : 0.22 + (c / maxCount) * 0.78,
	};
});

function relativeAgo(iso: string | null): string {
	if (!iso) return 'no recent push';
	const sec = (Date.now() - new Date(iso).getTime()) / 1000;
	if (sec < 60) return 'just now';
	if (sec < 3600) return `${Math.floor(sec / 60)}m ago`;
	if (sec < 86400) return `${Math.floor(sec / 3600)}h ago`;
	if (sec < 86400 * 7) return `${Math.floor(sec / 86400)}d ago`;
	return `${Math.floor(sec / (86400 * 7))}w ago`;
}
const lastPushedAgo = relativeAgo(lastPushed);
---

<BaseLayout
	title="Emilio Melis · edge AI & native systems"
	description="CS engineering student building edge AI runtimes, native systems, and low-level software for constrained hardware."
>
	{/* ============================== §00 · HERO ============================== */}
	<section class="hero" id="top" aria-labelledby="hero-title">
		<div class="hero__bg" aria-hidden="true" data-parallax="0.05"></div>

		<div class="wrapper hero__inner" data-reveal-stagger>
			<div class="hero__main">
				<h1 class="hero__title" id="hero-title" data-reveal>
					Emilio&nbsp;Melis.<br />
					builds <em>edge&nbsp;AI</em> that<br />
					runs <em class="hero__title-mark"><span class="hero__title-text">where it&nbsp;lives</span><svg
							class="hero__title-stroke"
							viewBox="0 0 320 18"
							aria-hidden="true"
							preserveAspectRatio="none"
						><path
								d="M3 13 C 38 4, 84 15, 128 9 C 172 4, 218 17, 262 11 C 286 8, 302 14, 318 5"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
							/></svg></em>.
				</h1>
				<p class="hero__lede" data-reveal>
					Native runtimes, sensor fusion, AI on constrained hardware.
				</p>

				<div class="hero__actions" data-reveal>
					<a class="btn btn--solid" href="#work">
						<span>Work</span>
						<span aria-hidden="true">→</span>
					</a>
					<a class="btn btn--ghost" href="/Portfolio/CV-English.pdf">
						<span>CV</span>
						<span aria-hidden="true">↓</span>
					</a>
				</div>
			</div>
		</div>
	</section>

	{/* ============================== §01 · WORK ============================== */}
	<section class="section" id="work" aria-labelledby="work-title">
		<div class="wrapper">
			<header class="section__head" data-reveal>
				<p class="section-marker">01 · selected work</p>
				<h2 id="work-title" class="section__title">
					Systems I built and <em>shipped</em>.
				</h2>
			</header>

			<div id="selected-work" class="work">
				{flagship && (
					<div class="work__flagship">
						<PortfolioPreview project={flagship} variant="dominant" />
					</div>
				)}

				{secondary.length > 0 && (
					<div class="secondary-grid work__secondary" data-reveal-stagger>
						{secondary.map((project) => (
							<PortfolioPreview project={project} variant="secondary" />
						))}
					</div>
				)}
			</div>
		</div>
	</section>

	{/* ============================== §02 · ABOUT ============================== */}
	<section class="section section--about" id="about" aria-labelledby="about-title">
		<div class="wrapper about">
			<header class="section__head" data-reveal>
				<p class="section-marker">02 · about</p>
				<h2 id="about-title" class="section__title">
					CS engineering student at <em>Polytech&nbsp;Tours</em>,<br />
					going deep on <em>edge inference</em> and <em>embedded&nbsp;control</em>.
				</h2>
			</header>

			<div class="about__grid">
				<div class="about__prose" data-reveal>
					<p class="about__pull">
						Native runtimes, embedded control, sensor fusion — anywhere the runtime
						has to be <strong>honest about the hardware</strong>.
					</p>

					<dl class="about__facts">
						{aboutFacts.map((fact) => (
							<div class="about__fact">
								<dt>{fact.label}</dt>
								<dd>{fact.value}</dd>
							</div>
						))}
					</dl>

					<div class="about__activity" data-reveal aria-label="GitHub activity, last 90 days">
						<div class="about__activity-head">
							<span class="label">last 90 days · github</span>
							<span class="about__activity-meta">
								last push <em>{lastPushedAgo}</em> · {totalCommits} commits visible
							</span>
						</div>
						<svg class="about__activity-strip" viewBox={`0 0 ${activityGrid.length * 3} 14`} preserveAspectRatio="none" aria-hidden="true">
							{activityGrid.map((cell, i) => (
								<rect x={i * 3} y={2} width={2} height={10} fill="currentColor" opacity={cell.opacity}>
									<title>{cell.date}: {cell.count} commit{cell.count === 1 ? '' : 's'}</title>
								</rect>
							))}
						</svg>
						<div class="about__activity-axis" aria-hidden="true">
							<span>90d ago</span>
							<span>today</span>
						</div>
					</div>
				</div>

				<aside class="about__notes" data-reveal aria-label="Side notes">
					{sideNotes.map((note) => (
						<div class="about__note">
							<span class="about__note-mark" aria-hidden="true">{note.mark}</span>
							<p>{note.text}</p>
						</div>
					))}
				</aside>
			</div>
		</div>
	</section>

	{/* ============================== §03 · STACK ============================== */}
	<section class="section" id="stack" aria-labelledby="stack-title">
		<div class="wrapper">
			<header class="section__head" data-reveal>
				<p class="section-marker">03 · stack</p>
				<h2 id="stack-title" class="section__title">
					Tools I reach for, <em>ranked by hours&nbsp;in&nbsp;hand</em>.
				</h2>
			</header>

			<StackInventory />
		</div>
	</section>

	{/* ============================== §05 · MORE WORK ============================== */}
	{additionalProjects.length > 0 && (
		<section class="section" id="more" aria-labelledby="more-title">
			<div class="wrapper">
				<header class="section__head" data-reveal>
					<p class="section-marker">05 · index</p>
					<h2 id="more-title" class="section__title">
						More work <em>worth a look</em>.
					</h2>
				</header>

				<ul class="project-index" data-reveal-stagger>
					{additionalProjects.map((project, i) => (
						<li class="project-index__row" data-reveal>
							<a href={`/Portfolio/work/${project.id}`} class="project-index__link">
								<span class="project-index__num">{String(i + 1).padStart(2, '0')}</span>
								<h3 class="project-index__title">{project.data.title}</h3>
								<span class="project-index__stack">{project.data.stackLine}</span>
								<span class="project-index__arrow" aria-hidden="true">→</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>
	)}
</BaseLayout>

<style>
	/* ====================== HERO ====================== */
	.hero {
		position: relative;
		padding-block: clamp(5rem, 11vw, 9rem) clamp(4rem, 8vw, 7rem);
		min-height: calc(100svh - 4rem);
		display: flex;
		flex-direction: column;
		justify-content: center;
		overflow: clip;
		border-bottom: 1px solid var(--rule-soft);
	}

	.hero__bg {
		position: absolute;
		inset: -10vh -10vw auto auto;
		width: 60vw;
		height: 60vw;
		max-width: 720px;
		max-height: 720px;
		background: radial-gradient(
			closest-side,
			color-mix(in srgb, var(--accent) 8%, transparent),
			transparent 70%
		);
		pointer-events: none;
		filter: blur(48px);
		opacity: 0.55;
		will-change: transform;
	}

	[data-theme='dark'] .hero__bg {
		opacity: 0.4;
	}

	.hero__inner {
		position: relative;
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		max-width: 56rem;
	}

	.hero__strip {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		align-items: baseline;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		color: var(--mute);
		text-transform: lowercase;
	}

	.hero__spec {
		display: inline-flex;
		gap: 0.4rem;
		align-items: baseline;
	}

	.hero__spec-key {
		color: var(--accent);
		font-weight: 500;
		letter-spacing: 0.08em;
	}

	.hero__spec-val {
		color: var(--ink-soft);
	}

	.hero__spec-sep {
		color: var(--mute-soft);
		margin-inline: 0.2rem;
	}

	.hero__eyebrow {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		color: var(--mute);
		margin-bottom: 1.2rem;
		text-transform: lowercase;
	}

	.hero__title {
		font-family: var(--font-display);
		font-size: clamp(3rem, 9vw, 6.6rem);
		font-weight: 400;
		font-variation-settings: 'opsz' 144, 'SOFT' 30, 'WONK' 1;
		letter-spacing: -0.028em;
		line-height: 0.94;
		max-width: 18ch;
		margin-bottom: 2.2rem;
	}

	.hero__title em {
		color: var(--accent);
		font-style: italic;
		font-variation-settings: 'opsz' 144, 'SOFT' 90, 'WONK' 1;
		transition: font-variation-settings 420ms var(--ease);
	}

	.hero__title em:hover {
		font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1;
	}

	.hero__title-mark {
		position: relative;
		display: inline-block;
		isolation: isolate;
	}

	.hero__title-stroke {
		position: absolute;
		left: -2%;
		right: -2%;
		bottom: -0.18em;
		width: 104%;
		height: 0.32em;
		color: var(--accent);
		opacity: 0.85;
		pointer-events: none;
		overflow: visible;
	}

	.hero__title-stroke path {
		stroke-dasharray: 360;
		stroke-dashoffset: 360;
		transition: stroke-dashoffset 1100ms var(--ease) 320ms;
	}

	:global(.js [data-reveal].is-visible) .hero__title-stroke path {
		stroke-dashoffset: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__title-stroke path {
			stroke-dashoffset: 0;
			transition: none;
		}
	}

	.hero__lede {
		max-width: 38rem;
		font-size: clamp(1.05rem, 1.6vw, 1.2rem);
		line-height: 1.65;
		color: var(--ink-soft);
		margin-bottom: 2rem;
	}

	.hero__lede strong {
		color: var(--ink);
		font-weight: 500;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.78rem 1.1rem;
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.08em;
		text-transform: lowercase;
		border: 1px solid var(--ink);
		transition:
			background-color 220ms var(--ease),
			color 220ms var(--ease),
			transform 220ms var(--ease);
	}

	.btn--solid {
		background: var(--ink);
		color: var(--paper);
	}

	.btn--solid:hover {
		background: var(--accent);
		border-color: var(--accent);
	}

	.btn--ghost {
		background: transparent;
		color: var(--ink);
		border-color: var(--rule);
	}

	.btn--ghost:hover {
		border-color: var(--ink);
		color: var(--accent);
	}

	/* ====================== SECTION ====================== */
	.section {
		padding-block: clamp(4rem, 9vw, 8rem);
		position: relative;
	}

	.section--about {
		background: var(--paper-soft);
		border-block: 1px solid var(--rule);
	}

	.section__head {
		display: grid;
		gap: 1.4rem;
		margin-bottom: 3rem;
		max-width: 56rem;
	}

	.section__title {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3.6rem);
		line-height: 1.04;
		font-weight: 400;
		letter-spacing: -0.022em;
	}

	.section__title em {
		color: var(--accent);
		font-style: italic;
	}

	.section__title-row {
		display: grid;
		gap: 1.25rem;
	}

	.section__lede {
		max-width: 36rem;
		color: var(--ink-soft);
		font-size: 1.02rem;
		line-height: 1.65;
	}

	/* ====================== WORK ====================== */
	.work {
		display: grid;
		gap: 0;
	}

	.work__secondary {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0;
		border-top: 1px solid var(--rule);
	}

	/* ====================== ABOUT ====================== */
	.about__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		align-items: start;
	}

	.about__prose {
		display: grid;
		gap: 2rem;
		max-width: 44rem;
		font-size: 1.05rem;
		line-height: 1.65;
		color: var(--ink-soft);
	}

	.about__pull {
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 2.8vw, 2.2rem);
		font-style: italic;
		line-height: 1.28;
		letter-spacing: -0.014em;
		color: var(--ink);
		font-variation-settings: 'opsz' 144, 'SOFT' 80, 'WONK' 0;
		max-width: 32rem;
	}

	.about__pull strong {
		font-style: normal;
		color: var(--accent);
		font-weight: 400;
	}

	.about__facts {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.55rem 1.2rem;
		margin: 0;
		padding-top: 1.4rem;
		border-top: 1px dashed var(--rule);
		font-family: var(--font-mono);
		font-size: 0.84rem;
		line-height: 1.55;
	}

	.about__fact {
		display: contents;
	}

	.about__fact dt {
		color: var(--accent);
		text-transform: uppercase;
		font-size: 0.7rem;
		letter-spacing: 0.16em;
		padding-top: 0.2rem;
	}

	.about__fact dd {
		margin: 0;
		color: var(--ink);
	}

	.about__notes {
		display: grid;
		gap: 1.1rem;
		padding-top: 1.2rem;
		border-top: 1px dashed var(--rule);
	}

	.about__note {
		display: grid;
		grid-template-columns: 1.4rem 1fr;
		gap: 0.7rem;
		font-size: 0.92rem;
		line-height: 1.55;
		color: var(--ink-soft);
	}

	.about__note-mark {
		font-family: var(--font-mono);
		color: var(--accent);
		font-size: 1rem;
		line-height: 1.2;
	}

	.about__activity {
		margin-top: 1.6rem;
		padding-top: 1.4rem;
		border-top: 1px dashed var(--rule);
		color: var(--ink);
		display: grid;
		gap: 0.55rem;
	}

	.about__activity-head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1.25rem;
		align-items: baseline;
	}

	.about__activity-meta {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		color: var(--mute);
	}

	.about__activity-meta em {
		font-style: normal;
		color: var(--ink-soft);
		font-family: var(--font-mono);
	}

	.about__activity-strip {
		width: 100%;
		height: 1.6rem;
		color: var(--accent);
		display: block;
	}

	.about__activity-axis {
		display: flex;
		justify-content: space-between;
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--mute-soft);
	}

	/* ====================== PROJECT INDEX ====================== */
	.project-index {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--rule);
	}

	.project-index__row {
		border-bottom: 1px solid var(--rule);
	}

	.project-index__link {
		display: grid;
		grid-template-columns: auto 1fr auto auto;
		align-items: center;
		gap: 1.2rem 2rem;
		padding-block: 1.4rem;
		color: var(--ink);
		position: relative;
	}

	.project-index__link::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		width: 0;
		height: 100%;
		background: var(--accent);
		opacity: 0;
		transition: width 280ms var(--ease), opacity 280ms var(--ease);
	}

	.project-index__link:hover::before {
		width: 3px;
		opacity: 1;
	}

	.project-index__link:hover {
		background: color-mix(in srgb, var(--paper-soft) 60%, transparent);
	}

	.project-index__link:hover .project-index__title {
		color: var(--accent);
	}

	.project-index__num {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--mute);
		letter-spacing: 0.08em;
		font-variant-numeric: tabular-nums;
	}

	.project-index__title {
		font-family: var(--font-display);
		font-size: clamp(1.3rem, 2.2vw, 1.8rem);
		font-weight: 400;
		letter-spacing: -0.015em;
		color: var(--ink);
		line-height: 1.1;
	}

	.project-index__stack {
		display: none;
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: var(--mute);
		text-align: right;
	}

	.project-index__arrow {
		font-family: var(--font-mono);
		color: var(--mute);
		font-size: 1rem;
		transition: transform 280ms var(--ease), color 280ms var(--ease);
	}

	.project-index__link:hover .project-index__arrow {
		color: var(--accent);
		transform: translateX(4px);
	}

	@media (min-width: 68em) {
		.about__grid {
			grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
			gap: 3.5rem;
		}

		.project-index__link {
			grid-template-columns: auto 1fr auto auto;
		}

		.project-index__stack {
			display: inline;
		}
	}
</style>
